# Members of the gnome group never installed. One per line: condition, name. A
# dependency of another member still arrives.
#
# always      every desktop
# slim        slim desktop only
# no-flatpak  without Flatpak, which it depends on
# bazaar      with Bazaar, which replaces it
#
# The browser task installs the chosen browser, GNOME Web included.
always epiphany
no-flatpak malcontent
bazaar gnome-software
slim gnome-calendar
slim gnome-maps
slim gnome-contacts
slim gnome-font-viewer
slim gnome-characters
slim gnome-clocks
slim gnome-connections
slim gnome-music
slim gnome-weather
slim gnome-calculator
slim gnome-logs
slim gnome-disk-utility
slim simple-scan
slim baobab
slim snapshot
slim loupe
slim decibels
slim showtime
slim papers
