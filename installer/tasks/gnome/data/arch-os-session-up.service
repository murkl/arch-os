# Written by Arch OS.
[Unit]
Description=Arch OS start counted once the session in front is up
Documentation=https://systemd.io/AUTOMATIC_BOOT_ASSESSMENT/
# Without a display manager there is no session to wait for.
ConditionPathExists=/etc/systemd/system/display-manager.service
Before=boot-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/arch-os/session-up.sh 300

[Install]
RequiredBy=boot-complete.target
