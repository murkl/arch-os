[[ $- != *i* ]] && return

# On a text console nothing else imports environment.d. The generator quotes
# like a shell, so every value arrives as written.
if [[ ${SHLVL} == 1 && -z ${DISPLAY} ]]; then
    set -a
    # shellcheck source=/dev/null
    source <(/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator)
    set +a
fi

source "${HOME}/.aliases"

shopt -s autocd
shopt -s checkwinsize
shopt -s histappend
shopt -s cmdhist
shopt -s extglob
shopt -s no_empty_cmd_completion
shopt -s expand_aliases

bind "set completion-ignore-case on"

if command -v bat &>/dev/null; then
    export MANPAGER="sh -c 'col -bx | bat -l man -p'"
    export MANROFFOPT="-c"
fi

# Same size and ignore list as in .zshrc.
export HISTSIZE=100000
export HISTFILESIZE=${HISTSIZE}
export HISTCONTROL=ignoreboth:erasedups
export HISTTIMEFORMAT="%F %T "
export HISTIGNORE="&:ls:ll:la:cd:exit:clear:history:fetch:q:c"

# The stock colors without the backgrounds that paint every world-writable
# directory green. Palette numbers, so the terminal's palette decides.
export LS_COLORS="di=1;34:ln=36:so=35:pi=33:ex=32:bd=33;1:cd=33;1:su=31:sg=31:tw=34:ow=34"

[ -f /usr/share/fzf/key-bindings.bash ] && source /usr/share/fzf/key-bindings.bash
[ -f /usr/share/fzf/completion.bash ] && source /usr/share/fzf/completion.bash

# GNOME Console opens a new tab in the current folder.
[ -f /etc/profile.d/vte.sh ] && source /etc/profile.d/vte.sh

# The text console (TERM=linux) lacks the prompt's glyphs. TERM, unlike the
# terminal device, holds after su, in a chroot and over ssh.
[[ $TERM != linux ]] && command -v starship &>/dev/null && eval "$(starship init bash)"
command -v zoxide &>/dev/null && eval "$(zoxide init bash)"
