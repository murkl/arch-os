" Written by Arch OS. A vimrc skips defaults.vim unless it sources it.
unlet! skip_defaults_vim
source $VIMRUNTIME/defaults.vim

set number
set laststatus=2

set expandtab shiftwidth=4 softtabstop=4
set ignorecase smartcase hlsearch

" Close to the Nord of the console and the prompt.
colorscheme habamax
