#!/usr/bin/env bash
# --boot-loader-entry holds for the next boot only.

case "${LC_ALL:-${LC_MESSAGES:-$LANG}}" in
de*)
    question="In die Recovery neu starten?"
    restart="Neu starten"
    cancel="Abbrechen"
    ;;
*)
    question="Restart into the Recovery?"
    restart="Restart"
    cancel="Cancel"
    ;;
esac

# Opens on Cancel: a restart closes every window.
zenity --question --title=Recovery --text="$question" \
    --ok-label="$restart" --cancel-label="$cancel" --default-cancel || exit 0
systemctl reboot --boot-loader-entry="{{ENTRY}}"
