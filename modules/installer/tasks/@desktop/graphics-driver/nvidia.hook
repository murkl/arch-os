[Trigger]
Operation=Install
Operation=Upgrade
Operation=Remove
Type=Package
Target={{DRIVER}}
Target={{KERNEL}}

[Action]
Description=Update the NVIDIA module in the initramfs
Depends=mkinitcpio
When=PostTransaction
NeedsTargets
Exec=/bin/sh -c 'while read -r trg; do case $trg in linux*) exit 0; esac; done; /usr/bin/mkinitcpio -P'
