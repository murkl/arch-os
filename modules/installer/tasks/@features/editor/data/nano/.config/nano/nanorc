# Written by the Arch OS Installer: what nano opens with, in the palette of the
# terminal it runs in. `man nanorc` names everything that can go here.

# Where the cursor is, how far down the file, and a line number for every line.
set linenumbers
set minibar
set indicator

# Typing as in any other editor: the mouse places the cursor, a new line keeps
# the indent of the one before, and Del or Backspace erase what is marked.
set mouse
set autoindent
set zap
set tabsize 4

# Long lines wrap at a word rather than run off the screen, and a file opened
# again opens where it was left.
set softwrap
set atblanks
set positionlog

set minicolor bold,lightwhite,blue
set numbercolor lightblack
set keycolor cyan
set functioncolor lightwhite
set errorcolor bold,lightwhite,red

# Syntax highlighting: what nano ships, its extra set, and the definitions from
# nano-syntax-highlighting. A glob that matches nothing is simply skipped.
include /usr/share/nano/*.nanorc
include /usr/share/nano/extra/*.nanorc
include /usr/share/nano-syntax-highlighting/*.nanorc
