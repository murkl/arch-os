msgstr ""

#. ARCH_OS_VIRTUAL_MACHINE: the question
#: module.yaml
msgid "Virtual machine"
msgstr ""

#. ARCH_OS_VIRTUAL_MACHINE: what it means
#: module.yaml
msgid "Whether this machine is itself a virtual one."
msgstr ""

#. ARCH_OS_VM_HOST_ENABLED: the question
#: module.yaml
msgid "Virtual machines"
msgstr ""

#. ARCH_OS_VM_HOST_ENABLED: what it means
#: module.yaml
msgid "QEMU and libvirt, and on a desktop the Virtual Machine Manager. Inside a virtual machine its guest tools are installed instead."
msgstr ""

#. ARCH_OS_DESKTOP: the question
#: module.yaml
msgid "Environment"
msgstr ""

#. ARCH_OS_DESKTOP: what it means
#: module.yaml
msgid "gnome installs the GNOME desktop, none stays on the text console."
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_LAYOUT: the question
#: module.yaml
msgid "Desktop keyboard"
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_LAYOUT: what it means
#: module.yaml
msgid "The keyboard layout of the desktop. auto matches the console keyboard."
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_VARIANT: the question
#: module.yaml
msgid "Keyboard variant"
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_VARIANT: what it means
#: module.yaml
msgid "A variation of that layout, such as dead keys. none is the standard one."
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_MODEL: the question
#: module.yaml
msgid "Keyboard model"
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_MODEL: what it means
#: module.yaml
msgid "The physical shape of the keyboard. pc105 fits almost every keyboard sold."
msgstr ""

#. ARCH_OS_DESKTOP_EXTRAS_ENABLED: the question
#: module.yaml
msgid "Desktop extras"
msgstr ""

#. ARCH_OS_DESKTOP_EXTRAS_ENABLED: what it means
#: module.yaml
msgid "Codecs, fonts, printing, network protocols, development tools and everyday applications."
msgstr ""

#. ARCH_OS_DESKTOP_SLIM_ENABLED: the question
#: module.yaml
msgid "Slim desktop"
msgstr ""

#. ARCH_OS_DESKTOP_SLIM_ENABLED: what it means
#: module.yaml
msgid "Removes the GNOME applications that come with the desktop and are rarely used."
msgstr ""

#. ARCH_OS_BROWSER: the question
#: module.yaml
msgid "Web browser"
msgstr ""

#. ARCH_OS_BROWSER: what it means
#: module.yaml
msgid "In the system language and opened for every link. epiphany is GNOME Web, vivaldi brings the codecs for proprietary video."
msgstr ""

#. ARCH_OS_BACKUP: the question
#: module.yaml
msgid "Backup"
msgstr ""

#. ARCH_OS_BACKUP: what it means
#: module.yaml
msgid "Backs up your files on a schedule, to a drive or a server."
msgstr ""

#. ARCH_OS_FLATPAK_ENABLED: the question
#: module.yaml
msgid "Flatpak"
msgstr ""

#. ARCH_OS_FLATPAK_ENABLED: what it means
#: module.yaml
msgid "Applications from Flathub, installed and updated through GNOME Software. Parental Controls need it."
msgstr ""

#. ARCH_OS_SAMBA_SHARE_ENABLED: the question
#: module.yaml
msgid "File sharing"
msgstr ""

#. ARCH_OS_SAMBA_SHARE_ENABLED: what it means
#: module.yaml
msgid "Shares your home and a public folder with Windows and macOS on networks marked home, or on every network without the firewall. Anyone there can try your password against it."
msgstr ""

