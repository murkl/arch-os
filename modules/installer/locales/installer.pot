# Translation template for installer.
#
# One catalog per language beside this file, named by its code: de.po, fr.po.
# The msgid is the English source text and the key at once, so a message no
# catalog has anything to say about is shown exactly as it stands here — which
# is what makes a half-finished translation useful from its first line.
#
# Generated. See the Makefile.
msgid ""
msgstr ""
"Project-Id-Version: installer\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

#. the name of this language in the language itself — "Deutsch", not
#. "German". A list of languages is read by the people who speak them.
msgid "English"
msgstr ""

#. what this program is called, where the interface talks about it
#: module.yaml
msgid "Installer"
msgstr ""

#. what opening it does, on the row that opens it
#: module.yaml
msgid "Install"
msgstr ""

#. what it is, in one sentence, on the page that offers it
#: module.yaml
msgid "Put Arch Linux on this machine."
msgstr ""

#. how to get back in, read on the way out to the console
#: module.yaml
msgid "Type installer at the prompt to start it again."
msgstr ""

#. the last thing read before the first task runs
#: module.yaml
msgid ""
"Arch Linux will be installed on {{ARCH_OS_DISK}} as {{ARCH_OS_HOSTNAME}}.\n"
"\n"
"Everything on that disk will be erased and this cannot be undone. Nothing has been changed so far."
msgstr ""

#. a starting point: the question
#: module.yaml
msgid "Setup"
msgstr ""

#. starting point Setup: what it means
#: module.yaml
msgid "Choose what kind of system to install. Every detail can still be changed afterwards."
msgstr ""

#. starting point Setup: a row
#: module.yaml
msgid "Desktop"
msgstr ""

#. starting point Setup, Desktop: what choosing it does
#: module.yaml
msgid "A GNOME desktop with drivers, codecs, fonts and everyday applications."
msgstr ""

#. starting point Setup: a row
#: module.yaml
msgid "Minimal"
msgstr ""

#. starting point Setup, Minimal: what choosing it does
#: module.yaml
msgid "Arch Linux on the console only. No desktop, no extras, nothing beyond what you choose."
msgstr ""

#. starting point Setup: a row
#: module.yaml
msgid "Online (paste.rs)"
msgstr ""

#. starting point Setup, Online (paste.rs): what choosing it does
#: module.yaml
msgid "Load every answer from a configuration shared at the end of an earlier installation."
msgstr ""

#. ARCH_OS_LOCALE_LANG: the question
#: module.yaml
msgid "Language and region"
msgstr ""

#. ARCH_OS_LOCALE_LANG: what it means
#: module.yaml
msgid "The locale this system is set up for, for example de_DE for German as used in Germany. It sets the system language and the format for dates, numbers and currency, and on auto also the keyboard layout, console font, time zone and mirror country. English is always installed as a fallback."
msgstr ""

#. ARCH_OS_LOCALE_LANG: the heading its row sits under
#: module.yaml
msgid "Region"
msgstr ""

#. ARCH_OS_VCONSOLE_KEYMAP: the question
#: module.yaml
msgid "Console keyboard"
msgstr ""

#. ARCH_OS_VCONSOLE_KEYMAP: what it means
#: module.yaml
msgid "The keyboard you are typing on right now. It is loaded immediately, and used by the new system on the text console. auto uses the layout for the system language chosen further down."
msgstr ""

#. ARCH_OS_VCONSOLE_FONT: the question
#: module.yaml
msgid "Console font"
msgstr ""

#. ARCH_OS_VCONSOLE_FONT: what it means
#: module.yaml
msgid "The font used on the text console. auto picks one that can display the chosen language; a larger font helps on a high-resolution screen."
msgstr ""

#. ARCH_OS_VCONSOLE_FONT: the row that opens a box for an answer of one's
#. own
#: module.yaml
msgid "Type a font name"
msgstr ""

#. ARCH_OS_TIMEZONE: the question
#: module.yaml
msgid "Time zone"
msgstr ""

#. ARCH_OS_TIMEZONE: what it means
#: module.yaml
msgid "Where this machine is located, so the clock is set correctly. The list opens on the time zone for the chosen country."
msgstr ""

#. ARCH_OS_REFLECTOR_COUNTRY: the question
#: module.yaml
msgid "Mirror country"
msgstr ""

#. ARCH_OS_REFLECTOR_COUNTRY: what it means
#: module.yaml
msgid "Where package downloads come from. auto uses the country for the chosen language, none ranks every mirror worldwide by speed. auto falls back to none when Arch has no mirror for that country."
msgstr ""

#. ARCH_OS_REFLECTOR_COUNTRY: the row that opens a box for an answer of
#. one's own
#: module.yaml
msgid "Type a country"
msgstr ""

#. ARCH_OS_USERNAME: the question
#: module.yaml
msgid "Username"
msgstr ""

#. ARCH_OS_USERNAME: what it means
#: module.yaml
msgid "The account you will log in with. Lowercase letters, digits, hyphens and underscores only. It cannot start with a digit."
msgstr ""

#. ARCH_OS_USERNAME: the heading its row sits under
#: module.yaml
msgid "Identity"
msgstr ""

#. ARCH_OS_USERNAME: what a wrong answer is told
#: module.yaml
msgid "Lowercase letters, digits, hyphens and underscores only, up to 32 characters. It cannot start with a digit."
msgstr ""

#. ARCH_OS_PASSWORD: the question
#: module.yaml
msgid "Password"
msgstr ""

#. ARCH_OS_PASSWORD: what it means
#: module.yaml
msgid "Used for your account, the root account, and — if disk encryption is on — to unlock the disk at boot. It is asked for right before installation starts and is never written to a file."
msgstr ""

#. ARCH_OS_HOSTNAME: the question
#: module.yaml
msgid "Hostname"
msgstr ""

#. ARCH_OS_HOSTNAME: what it means
#: module.yaml
msgid "The name this machine has on the network."
msgstr ""

#. ARCH_OS_HOSTNAME: what a wrong answer is told
#: module.yaml
msgid "Lowercase letters, digits and hyphens only, up to 63 characters. It cannot start or end with a hyphen."
msgstr ""

#. ARCH_OS_DISK: the question
#: module.yaml
msgid "Disk"
msgstr ""

#. ARCH_OS_DISK: what it means
#: module.yaml
msgid "The disk Arch Linux will be installed on. Unless dual boot is enabled, everything on it will be erased."
msgstr ""

#. ARCH_OS_DISK: the heading its row sits under
#: module.yaml
msgid "Storage"
msgstr ""

#. ARCH_OS_DISK: what a wrong answer is told
#: module.yaml
msgid "Choose a disk that exists."
msgstr ""

#. ARCH_OS_FILESYSTEM: the question
#: module.yaml
msgid "File system"
msgstr ""

#. ARCH_OS_FILESYSTEM: what it means
#: module.yaml
msgid "btrfs supports snapshots, so a system update can be rolled back. ext4 is simpler, but does not support that."
msgstr ""

#. ARCH_OS_ENCRYPTION_ENABLED: the question
#: module.yaml
msgid "Disk encryption"
msgstr ""

#. ARCH_OS_ENCRYPTION_ENABLED: what it means
#: module.yaml
msgid "Encrypts the whole system with your password, so the data cannot be read by removing the disk. The password is then required at every boot."
msgstr ""

#. ARCH_OS_BTRFS_SNAPPER_ENABLED: the question
#: module.yaml
msgid "Snapshots"
msgstr ""

#. ARCH_OS_BTRFS_SNAPPER_ENABLED: what it means
#: module.yaml
msgid "Takes a snapshot before every package change and cleans up old ones automatically, so a bad update can be undone."
msgstr ""

#. ARCH_OS_BTRFS_ASSISTANT_ENABLED: the question
#: module.yaml
msgid "Snapshot manager"
msgstr ""

#. ARCH_OS_BTRFS_ASSISTANT_ENABLED: what it means
#: module.yaml
msgid "A desktop application for browsing and restoring snapshots."
msgstr ""

#. ARCH_OS_DUAL_BOOT_ENABLED: the question
#: module.yaml
msgid "Dual boot"
msgstr ""

#. ARCH_OS_DUAL_BOOT_ENABLED: what it means
#: module.yaml
msgid "Install alongside a system already on this disk. Nothing is partitioned or erased, the existing EFI partition is reused and only a boot entry is added. Both partitions have to be chosen by you."
msgstr ""

#. ARCH_OS_BOOT_PARTITION: the question
#: module.yaml
msgid "Boot partition"
msgstr ""

#. ARCH_OS_BOOT_PARTITION: what it means
#: module.yaml
msgid "The existing EFI partition to add a boot entry to. It will not be formatted."
msgstr ""

#. ARCH_OS_ROOT_PARTITION: the question
#: module.yaml
msgid "Root partition"
msgstr ""

#. ARCH_OS_ROOT_PARTITION: what it means
#: module.yaml
msgid "The partition Arch Linux will be installed on. It will be formatted, and everything on it will be lost."
msgstr ""

#. ARCH_OS_BOOTLOADER: the question
#: module.yaml
msgid "Boot loader"
msgstr ""

#. ARCH_OS_BOOTLOADER: what it means
#: module.yaml
msgid "systemd-boot is small and needs no maintenance. GRUB can show a menu of btrfs snapshots to boot into."
msgstr ""

#. ARCH_OS_BOOTLOADER: the heading its row sits under
#: module.yaml
msgid "Boot"
msgstr ""

#. ARCH_OS_SECURE_BOOT_ENABLED: the question
#: module.yaml
msgid "Secure Boot"
msgstr ""

#. ARCH_OS_SECURE_BOOT_ENABLED: what it means
#: module.yaml
msgid "Signs the kernel and boot loader with keys generated for this machine, so the firmware starts nothing else. In firmware setup mode the keys are enrolled automatically and you only need to turn Secure Boot on afterwards. Otherwise everything is signed and enrolling the keys is left to you."
msgstr ""

#. ARCH_OS_KERNEL: the question
#: module.yaml
msgid "Kernel"
msgstr ""

#. ARCH_OS_KERNEL: what it means
#: module.yaml
msgid "linux-zen is tuned for desktop responsiveness. linux is the stock kernel, linux-lts a long-term one, linux-hardened a security-focused one."
msgstr ""

#. ARCH_OS_KERNEL_ARGS: the question
#: module.yaml
msgid "Kernel parameters"
msgstr ""

#. ARCH_OS_KERNEL_ARGS: what it means
#: module.yaml
msgid "Extra parameters passed to the kernel at boot, separated by spaces. Leave empty unless you know you need one."
msgstr ""

#. ARCH_OS_KERNEL_ARGS: what a wrong answer is told
#: module.yaml
msgid "Commas, ampersands and backslashes cannot be used here."
msgstr ""

#. ARCH_OS_MICROCODE: the question
#: module.yaml
msgid "Processor firmware"
msgstr ""

#. ARCH_OS_MICROCODE: what it means
#: module.yaml
msgid "Firmware updates loaded at boot. auto detects the processor automatically — the right choice unless you are preparing this image for a different machine."
msgstr ""

#. ARCH_OS_DESKTOP: what it means
#: module.yaml
msgid "gnome installs the GNOME desktop. none leaves the system on a text console, with nothing graphical installed."
msgstr ""

#. ARCH_OS_DESKTOP_GRAPHICS_DRIVER: the question
#: module.yaml
msgid "Graphics driver"
msgstr ""

#. ARCH_OS_DESKTOP_GRAPHICS_DRIVER: what it means
#: module.yaml
msgid "mesa is the open driver and fits almost every machine. Pick one matching your card only if you know you need it."
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_LAYOUT: the question
#: module.yaml
msgid "Desktop keyboard"
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_LAYOUT: what it means
#: module.yaml
msgid "The keyboard layout the desktop starts with. auto matches the console keyboard, using the desktop's own naming: de-latin1 and de are the same layout."
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_VARIANT: the question
#: module.yaml
msgid "Keyboard variant"
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_VARIANT: what it means
#: module.yaml
msgid "A variation of that layout, such as dead keys or a different punctuation arrangement. none is the standard one."
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_MODEL: the question
#: module.yaml
msgid "Keyboard model"
msgstr ""

#. ARCH_OS_DESKTOP_KEYBOARD_MODEL: what it means
#: module.yaml
msgid "The physical shape of the keyboard. pc105 fits almost every keyboard sold."
msgstr ""

#. ARCH_OS_DESKTOP_EXTRAS_ENABLED: the question
#: module.yaml
msgid "Desktop extras"
msgstr ""

#. ARCH_OS_DESKTOP_EXTRAS_ENABLED: what it means
#: module.yaml
msgid "Codecs, fonts, printing, network protocols, development tools and the applications that make the desktop usable straight away."
msgstr ""

#. ARCH_OS_DESKTOP_SLIM_ENABLED: the question
#: module.yaml
msgid "Slim desktop"
msgstr ""

#. ARCH_OS_DESKTOP_SLIM_ENABLED: what it means
#: module.yaml
msgid "Removes the GNOME applications that come with the desktop and are rarely used."
msgstr ""

#. ARCH_OS_DESKTOP_AUTOLOGIN_ENABLED: the question
#: module.yaml
msgid "Log in automatically"
msgstr ""

#. ARCH_OS_DESKTOP_AUTOLOGIN_ENABLED: what it means
#: module.yaml
msgid "Skips the login screen. auto follows disk encryption: a disk already unlocked at boot gains nothing from a second password, while without encryption the login screen is the only protection left."
msgstr ""

#. ARCH_OS_SAMBA_SHARE_ENABLED: the question
#: module.yaml
msgid "File sharing"
msgstr ""

#. ARCH_OS_SAMBA_SHARE_ENABLED: what it means
#: module.yaml
msgid "Shares your home folder and a public folder on the local network, readable by Windows and macOS."
msgstr ""

#. ARCH_OS_CORE_TWEAKS_ENABLED: the question
#: module.yaml
msgid "System tweaks"
msgstr ""

#. ARCH_OS_CORE_TWEAKS_ENABLED: what it means
#: module.yaml
msgid "Small adjustments that do not change what is installed: parallel package downloads, a quieter boot, password feedback in the terminal."
msgstr ""

#. ARCH_OS_CORE_TWEAKS_ENABLED: the heading its row sits under
#: module.yaml
msgid "System"
msgstr ""

#. ARCH_OS_BOOTSPLASH_ENABLED: the question
#: module.yaml
msgid "Boot splash"
msgstr ""

#. ARCH_OS_BOOTSPLASH_ENABLED: what it means
#: module.yaml
msgid "Shows a logo while the system starts instead of a wall of text."
msgstr ""

#. ARCH_OS_MULTILIB_ENABLED: the question
#: module.yaml
msgid "32-bit support"
msgstr ""

#. ARCH_OS_MULTILIB_ENABLED: what it means
#: module.yaml
msgid "Needed by Steam, Wine and other software that is still 32-bit."
msgstr ""

#. ARCH_OS_AUR_HELPER: the question
#: module.yaml
msgid "AUR helper"
msgstr ""

#. ARCH_OS_AUR_HELPER: what it means
#: module.yaml
msgid "Installs software from the Arch User Repository just as easily as from the official repositories."
msgstr ""

#. ARCH_OS_CONTAINER_ENGINE: the question
#: module.yaml
msgid "Container engine"
msgstr ""

#. ARCH_OS_CONTAINER_ENGINE: what it means
#: module.yaml
msgid "docker is what most software and documentation assumes. podman runs containers without a daemon and without root, and answers to the docker command as well. Both come with a compose command."
msgstr ""

#. ARCH_OS_HOUSEKEEPING_ENABLED: the question
#: module.yaml
msgid "Housekeeping"
msgstr ""

#. ARCH_OS_HOUSEKEEPING_ENABLED: what it means
#: module.yaml
msgid "Timers that keep the system tidy automatically: mirrors ranked weekly, the package cache trimmed, and disk health checked."
msgstr ""

#. ARCH_OS_SHELL_ENHANCEMENT_ENABLED: the question
#: module.yaml
msgid "Shell enhancement"
msgstr ""

#. ARCH_OS_SHELL_ENHANCEMENT_ENABLED: what it means
#: module.yaml
msgid "A better terminal out of the box: a prompt showing git state, colourful listings, fuzzy search, useful aliases."
msgstr ""

#. ARCH_OS_SHELL_ENHANCEMENT_SHELL: the question
#: module.yaml
msgid "Shell"
msgstr ""

#. ARCH_OS_SHELL_ENHANCEMENT_SHELL: what it means
#: module.yaml
msgid "bash is always set up; zsh or fish add completion and suggestions as you type and become the shell that opens instead."
msgstr ""

#. ARCH_OS_MANAGER_ENABLED: the question
#: module.yaml
msgid "Arch OS Manager"
msgstr ""

#. ARCH_OS_MANAGER_ENABLED: what it means
#: module.yaml
msgid "A menu for updating, cleaning up and repairing the system after installation."
msgstr ""

#. ARCH_OS_VM_SUPPORT_ENABLED: the question
#: module.yaml
msgid "Virtual machine support"
msgstr ""

#. ARCH_OS_VM_SUPPORT_ENABLED: what it means
#: module.yaml
msgid "Inside a virtual machine, the guest tools that make the screen resize and the clipboard work. On real hardware there is no guest to support, so it installs the other end instead: what it takes to run a virtual machine of your own. Without a desktop that is the console half of it, without the manager window."
msgstr ""

#. ARCH_OS_ECN_ENABLED: the question
#: module.yaml
msgid "Explicit congestion notification"
msgstr ""

#. ARCH_OS_ECN_ENABLED: what it means
#: module.yaml
msgid "Leave on. Turning it off helps only behind old routers that drop connections which use it."
msgstr ""

#. ARCH_OS_CONFIG_URL: the question
#: module.yaml
msgid "Shared at"
msgstr ""

#. ARCH_OS_CONFIG_URL: what it means
#: module.yaml
msgid "Where this installation's answers ended up. Nothing is uploaded until you accept the offer at the end of the run. The installation then fills this in itself and shows it as a code to scan."
msgstr ""

#. ARCH_OS_CONFIG_SOURCE: the question
#: module.yaml
msgid "Configuration code"
msgstr ""

#. ARCH_OS_CONFIG_SOURCE: what it means
#: module.yaml
msgid "The code of a shared configuration: the short word at the end of a paste.rs address, or the whole address. Every answer it contains can still be changed afterwards."
msgstr ""

#. ARCH_OS_CONFIG_SOURCE: what a wrong answer is told
#: module.yaml
msgid "A code such as aBc12, or the whole address it belongs to."
msgstr ""

