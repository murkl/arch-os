msgid ""
msgstr ""
"Project-Id-Version: installer\n"
"Language: de\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. the name of this language in the language itself — "Deutsch", not
#. "German". A list of languages is read by the people who speak them.
msgid "English"
msgstr "Deutsch"

#. what this module is called, wherever the interface names it
#: module.yaml
msgid "Installer"
msgstr "Installer"

#. what it is, in one sentence, under the row that starts the work
#: module.yaml
msgid "Install Arch Linux on this machine."
msgstr "Arch Linux auf diesen Rechner installieren."

#. the row that starts the work, and the button on the page before it
#: module.yaml
msgid "Install"
msgstr "Installieren"

#. a starting point: its row
#: module.yaml
msgid "Desktop"
msgstr "Desktop"

#. starting point Desktop: what choosing it does
#: module.yaml
msgid "The Core, with a GNOME desktop on top of it - drivers, codecs, fonts and everyday applications."
msgstr "Der Core, mit einem GNOME-Desktop darauf - Treiber, Codecs, Schriften und die Programme für den Alltag."

#. a starting point: its row
#: module.yaml
msgid "Core"
msgstr "Core"

#. starting point Core: what choosing it does
#: module.yaml
msgid "A minimal Arch Linux on the text console, with nothing graphical on it and nothing beyond what you choose."
msgstr "Ein minimales Arch Linux auf der Textkonsole, ohne alles Grafische und ohne alles, was du nicht selbst wählst."

#. a starting point: its row
#: module.yaml actions/import-config/action.yaml
msgid "Online (paste.rs)"
msgstr "Online (paste.rs)"

#. starting point Online (paste.rs): what choosing it does
#: module.yaml
msgid "Load every answer from a configuration shared at the end of an earlier installation."
msgstr "Alle Antworten aus einer Konfiguration übernehmen, die am Ende einer früheren Installation geteilt wurde."

#. ARCH_OS_USERNAME: the question
#: module.yaml
msgid "Username"
msgstr "Benutzername"

#. ARCH_OS_USERNAME: what it means
#: module.yaml
msgid "The account you will log in with. Lowercase letters, digits, hyphens and underscores only. It cannot start with a digit."
msgstr "Das Konto, mit dem du dich anmeldest. Kleinbuchstaben, Ziffern, Bindestrich und Unterstrich. Darf nicht mit einer Ziffer beginnen."

#. ARCH_OS_USERNAME: the heading its row sits under
#: module.yaml
msgid "Identity"
msgstr "Identität"

#. ARCH_OS_USERNAME: what a wrong answer is told
#: module.yaml
msgid "Lowercase letters, digits, hyphens and underscores only, up to 32 characters. It cannot start with a digit."
msgstr "Nur Kleinbuchstaben, Ziffern, Bindestrich und Unterstrich, höchstens 32 Zeichen. Darf nicht mit einer Ziffer beginnen."

#. ARCH_OS_PASSWORD: the question
#: module.yaml
msgid "Password"
msgstr "Passwort"

#. ARCH_OS_PASSWORD: what it means
#: module.yaml
msgid "Used for your account, the root account, and — if disk encryption is on — to unlock the disk at boot. It is asked for right before installation starts and is never written to a file."
msgstr "Gilt für dein Konto, für das Konto root und — bei aktiver Verschlüsselung — zum Entsperren des Datenträgers beim Start. Es wird unmittelbar vor dem Start der Installation abgefragt und nie in eine Datei geschrieben."

#. ARCH_OS_HOSTNAME: the question
#: module.yaml
msgid "Hostname"
msgstr "Rechnername"

#. ARCH_OS_HOSTNAME: what it means
#: module.yaml
msgid "The name this machine has on the network."
msgstr "Der Name, unter dem dieser Rechner im Netzwerk erscheint."

#. ARCH_OS_HOSTNAME: what a wrong answer is told
#: module.yaml
msgid "Lowercase letters, digits and hyphens only, up to 63 characters. It cannot start or end with a hyphen."
msgstr "Nur Kleinbuchstaben, Ziffern und Bindestrich, höchstens 63 Zeichen. Darf nicht mit einem Bindestrich beginnen oder enden."

#. ARCH_OS_LOCALE_LANG: the question
#: module.yaml
msgid "Language and region"
msgstr "Sprache und Region"

#. ARCH_OS_LOCALE_LANG: what it means
#: module.yaml
msgid "The locale this system is set up for, for example de_DE for German as used in Germany. It sets the system language and the format for dates, numbers and currency, and on auto also the keyboard layout, console font and time zone. English is always installed as a fallback, and the list opens on it."
msgstr "Die Locale, für die dieses System eingerichtet wird, zum Beispiel de_DE für Deutsch, wie es in Deutschland geschrieben wird. Sie legt die Systemsprache und die Formate für Datum, Zahlen und Währung fest, auf auto außerdem Tastaturbelegung, Konsolenschrift und Zeitzone. Englisch wird immer als Rückfallebene installiert, und die Liste öffnet darauf."

#. ARCH_OS_LOCALE_LANG: the heading its row sits under
#: module.yaml
msgid "Region"
msgstr "Region"

#. ARCH_OS_VCONSOLE_KEYMAP: the question
#: module.yaml
msgid "Console keyboard"
msgstr "Konsolentastatur"

#. ARCH_OS_VCONSOLE_KEYMAP: what it means
#: module.yaml
msgid "The keyboard you are typing on right now. It is loaded immediately, and used by the new system on the text console. auto uses the layout for the system language chosen further down."
msgstr "Die Tastatur, auf der du gerade tippst. Sie wird sofort geladen und ist zugleich die Belegung der Textkonsole des neuen Systems. auto ist die Belegung, auf der die Systemsprache getippt wird — die weiter unten festgelegt wird."

#. ARCH_OS_VCONSOLE_FONT: the question
#: module.yaml
msgid "Console font"
msgstr "Konsolenschrift"

#. ARCH_OS_VCONSOLE_FONT: what it means
#: module.yaml
msgid "The font used on the text console. auto picks one that can display the chosen language; a larger font helps on a high-resolution screen."
msgstr "Die Schrift der Textkonsole. auto ist die, die die gewählte Sprache darstellen kann; eine größere hilft auf einem hochauflösenden Bildschirm."

#. ARCH_OS_VCONSOLE_FONT: the row that opens a box for an answer of one's
#. own
#: module.yaml
msgid "Type a font name"
msgstr "Schriftnamen eingeben"

#. ARCH_OS_TIMEZONE: the question
#: module.yaml
msgid "Time zone"
msgstr "Zeitzone"

#. ARCH_OS_TIMEZONE: what it means
#: module.yaml
msgid "Where this machine is located, so the clock is set correctly. The list opens on the time zone for the chosen country."
msgstr "Wo dieser Rechner steht, damit die Uhr stimmt. Die Liste öffnet auf der Zeitzone des gewählten Landes."

#. ARCH_OS_REFLECTOR_COUNTRY: the question
#: module.yaml
msgid "Mirror country"
msgstr "Spiegelserver-Land"

#. ARCH_OS_REFLECTOR_COUNTRY: what it means
#: module.yaml
msgid "Where package downloads come from. auto uses the country of the chosen time zone, none ranks every mirror worldwide by speed. auto falls back to none when the time zone names no country or Arch has no mirror there."
msgstr "Woher Pakete geladen werden. auto ist das Land der gewählten Zeitzone, none sortiert weltweit alle Spiegelserver nach Geschwindigkeit. auto fällt auf none zurück, wo die Zeitzone kein Land nennt oder Arch dort keinen Spiegelserver hat."

#. ARCH_OS_REFLECTOR_COUNTRY: the row that opens a box for an answer of
#. one's own
#: module.yaml
msgid "Type a country"
msgstr "Land eingeben"

#. ARCH_OS_DISK: the question
#: module.yaml
msgid "Disk"
msgstr "Datenträger"

#. ARCH_OS_DISK: what it means
#: module.yaml
msgid "The disk Arch Linux will be installed on. Everything on it will be erased. The medium this live image is running from is not offered."
msgstr "Der Datenträger, auf dem Arch Linux installiert wird. Alles darauf wird gelöscht. Der Datenträger, von dem dieses Live-Abbild läuft, wird nicht angeboten."

#. ARCH_OS_DISK: the heading its row sits under
#: module.yaml
msgid "Storage"
msgstr "Speicher"

#. ARCH_OS_DISK: what a wrong answer is told
#: module.yaml
msgid "Choose a disk that exists."
msgstr "Wähle einen vorhandenen Datenträger."

#. ARCH_OS_ENCRYPTION_ENABLED: the question
#: module.yaml
msgid "Disk encryption"
msgstr "Verschlüsselung"

#. ARCH_OS_ENCRYPTION_ENABLED: what it means
#: module.yaml
msgid "Encrypts the whole system with your password, so the data cannot be read by removing the disk. The password is then required at every boot."
msgstr "Verschlüsselt das gesamte System mit deinem Passwort, sodass die Daten durch Ausbau des Datenträgers nicht lesbar sind. Das Passwort wird dann bei jedem Start abgefragt."

#. ARCH_OS_SECURE_BOOT_ENABLED: the question
#: module.yaml
msgid "Secure Boot"
msgstr "Secure Boot"

#. ARCH_OS_SECURE_BOOT_ENABLED: what it means
#: module.yaml
msgid "Signs the kernel and boot loader with keys generated for this machine, so the firmware starts nothing else. In firmware setup mode the keys are enrolled automatically and you only need to turn Secure Boot on afterwards. Otherwise everything is signed and enrolling the keys is left to you."
msgstr "Signiert Kernel und Bootloader mit Schlüsseln, die für diesen Rechner erzeugt werden, sodass die Firmware nichts anderes startet. Im Setup-Modus der Firmware werden die Schlüssel gleich hinterlegt und Secure Boot muss danach nur noch eingeschaltet werden. Sonst ist alles signiert und das Hinterlegen bleibt dir überlassen."

#. ARCH_OS_SECURE_BOOT_ENABLED: the heading its row sits under
#: module.yaml
msgid "Boot"
msgstr "Boot"

#. ARCH_OS_RECOVERY_ENABLED: the question
#: module.yaml
msgid "Recovery"
msgstr "Recovery"

#. ARCH_OS_RECOVERY_ENABLED: what it means
#: module.yaml
msgid "Puts the Recovery on a small partition of its own and into the boot menu, so a system that no longer starts is repaired without a USB stick. Hold space while the machine starts to reach the menu. The Arch OS ISO carries it; any other live image downloads it first."
msgstr "Legt die Recovery auf eine kleine eigene Partition und ins Bootmenü, damit sich ein System, das nicht mehr startet, ohne USB-Stick reparieren lässt. Für das Menü beim Start des Rechners die Leertaste gedrückt halten. Das Arch-OS-ISO bringt sie mit, jedes andere Live-Abbild lädt sie vorher herunter."

#. ARCH_OS_BOOTSPLASH_ENABLED: the question
#: module.yaml
msgid "Boot splash"
msgstr "Bootsplash"

#. ARCH_OS_BOOTSPLASH_ENABLED: what it means
#: module.yaml
msgid "Shows a logo while the system starts instead of a wall of text."
msgstr "Zeigt beim Start ein Logo statt einer Textwand."

#. ARCH_OS_KERNEL_ARGS: the question
#: module.yaml
msgid "Kernel parameters"
msgstr "Kernel-Parameter"

#. ARCH_OS_KERNEL_ARGS: what it means
#: module.yaml
msgid "Extra parameters passed to the kernel at boot, separated by spaces. Leave empty unless you know you need one."
msgstr "Zusätzliche Parameter, die dem Kernel beim Start übergeben werden, durch Leerzeichen getrennt. Leer lassen, solange du keinen brauchst."

#. ARCH_OS_CORE_TWEAKS_ENABLED: the question
#: module.yaml
msgid "Core tweaks"
msgstr "Core Optimierungen"

#. ARCH_OS_CORE_TWEAKS_ENABLED: what it means
#: module.yaml
msgid "Small adjustments to the Core that do not change what is installed: parallel package downloads, a quieter boot, password feedback in the terminal, and the memory, disk and log settings the system runs better on."
msgstr "Kleine Anpassungen am Core, die nichts an den installierten Paketen ändern: parallele Downloads, ein ruhigerer Start, Rückmeldung bei der Passworteingabe im Terminal und die Einstellungen für Speicher, Platte und Protokolle, mit denen das System besser läuft."

#. ARCH_OS_CORE_TWEAKS_ENABLED: the heading its row sits under
#: module.yaml
msgid "System"
msgstr "System"

#. ARCH_OS_MULTILIB_ENABLED: the question
#: module.yaml
msgid "32-bit support"
msgstr "32-Bit-Unterstützung"

#. ARCH_OS_MULTILIB_ENABLED: what it means
#: module.yaml
msgid "Needed by Steam, Wine and other software that is still 32-bit."
msgstr "Wird von Steam, Wine und anderer Software gebraucht, die noch 32-bit benötigen."

#. ARCH_OS_AUR_HELPER_ENABLED: the question
#: module.yaml
msgid "AUR helper"
msgstr "AUR-Helfer"

#. ARCH_OS_AUR_HELPER_ENABLED: what it means
#: module.yaml
msgid "Installs paru, which gets software from the Arch User Repository just as easily as from the official repositories. Built here, against the pacman this machine has, which takes about a quarter of an hour."
msgstr "Installiert paru, das Software aus dem Arch User Repository genauso einfach holt wie aus den offiziellen. Wird hier gebaut, gegen das pacman dieser Maschine, was rund eine Viertelstunde dauert."

#. ARCH_OS_CONTAINER_ENGINE: the question
#: module.yaml
msgid "Container engine"
msgstr "Container-Engine"

#. ARCH_OS_CONTAINER_ENGINE: what it means
#: module.yaml
msgid "docker needs a daemon running as root, which is what most software and documentation assumes. podman has neither and still answers to the docker command. Both bring a compose command."
msgstr "Docker braucht einen Daemon, der als root läuft — wovon die meiste Software und Dokumentation ausgeht. Podman hat beides nicht und hört trotzdem auf den Befehl docker. Beide bringen einen compose-Befehl mit."

#. ARCH_OS_FIREWALL_ENABLED: the question
#: module.yaml
msgid "Firewall"
msgstr "Firewall"

#. ARCH_OS_FIREWALL_ENABLED: what it means
#: module.yaml
msgid "Blocks incoming connections. Every network counts as public, a café's wifi included, and lets in only what this machine is set up to answer: SSH and finding printers. A network marked as home also reaches file sharing: nmcli connection modify <name> connection.zone home"
msgstr "Blockiert eingehende Verbindungen. Jedes Netz gilt als öffentlich, auch das WLAN im Café, und lässt nur herein, was dieser Rechner beantworten soll: SSH und die Suche nach Druckern. Ein als Heimnetz markiertes Netz erreicht auch die Dateifreigabe: nmcli connection modify <name> connection.zone home"

#. ARCH_OS_SSH_SERVER_ENABLED: the question
#: module.yaml
msgid "SSH server"
msgstr "SSH-Server"

#. ARCH_OS_SSH_SERVER_ENABLED: what it means
#: module.yaml
msgid "Lets you log in to this machine from another one over the network, with your account and password. Root cannot log in this way."
msgstr "Erlaubt die Anmeldung an diesem Rechner von einem anderen über das Netzwerk, mit deinem Konto und Passwort. Root kann sich so nicht anmelden."

#. ARCH_OS_HOUSEKEEPING_ENABLED: the question
#: module.yaml
msgid "Housekeeping"
msgstr "Systempflege"

#. ARCH_OS_HOUSEKEEPING_ENABLED: what it means
#: module.yaml
msgid "Timers that keep the system tidy automatically: mirrors ranked weekly, the package cache trimmed, and disk health checked."
msgstr "Zeitgesteuerte Aufgaben, die das System von selbst in Ordnung halten: Spiegelserver werden wöchentlich sortiert, der Paketzwischenspeicher geleert, die Laufwerksgesundheit überwacht."

#. ARCH_OS_EDITOR: the question
#: module.yaml
msgid "Text editor"
msgstr "Texteditor"

#. ARCH_OS_EDITOR: what it means
#: module.yaml
msgid "The editor that opens wherever a command asks for one: sudoedit, git, systemctl edit. nano and micro are typed into straight away, micro with the shortcuts of a desktop editor. vim, neovim and helix are modal: typing and commands are separate modes."
msgstr "Der Editor, der sich öffnet, wo ein Befehl nach einem fragt: sudoedit, git, systemctl edit. In nano und micro wird sofort geschrieben, in micro mit den Tastenkürzeln eines Desktop-Editors. vim, neovim und helix arbeiten mit Modi: Schreiben und Befehle sind getrennt."

#. ARCH_OS_SHELL_ENHANCEMENT_ENABLED: the question
#: module.yaml
msgid "Shell enhancement"
msgstr "Shell Optimierungen"

#. ARCH_OS_SHELL_ENHANCEMENT_ENABLED: what it means
#: module.yaml
msgid "A better terminal out of the box: zsh with completion and suggestions as you type, a prompt showing git state, colourful listings, fuzzy search, useful aliases."
msgstr "Ein besseres Terminal ohne Nacharbeit: zsh mit Vervollständigung und Vorschlägen beim Tippen, eine Eingabezeile mit Git-Status, farbige Auflistungen, unscharfe Suche, sinnvolle Kurzbefehle."

#. ARCH_OS_MANAGER_ENABLED: the question
#: module.yaml
msgid "Arch OS Manager"
msgstr "Arch OS Manager"

#. ARCH_OS_MANAGER_ENABLED: what it means
#: module.yaml
msgid "A menu for updating, cleaning up and repairing the system after installation."
msgstr "Ein Menü zum Aktualisieren, Aufräumen und Reparieren des Systems nach der Installation."

#. ARCH_OS_VIRTUAL_MACHINE: the question
#: module.yaml
msgid "Virtual machine"
msgstr "Virtuelle Maschine"

#. ARCH_OS_VIRTUAL_MACHINE: what it means
#: module.yaml
msgid "Whether this machine is itself a virtual one."
msgstr "Ob dieser Rechner selbst eine virtuelle Maschine ist."

#. ARCH_OS_VM_HOST_ENABLED: the question
#: module.yaml
msgid "Virtual machines"
msgstr "Virtuelle Maschinen"

#. ARCH_OS_VM_HOST_ENABLED: what it means
#: module.yaml
msgid "Runs virtual machines on this computer: QEMU and libvirt, and on a desktop the Virtual Machine Manager window. Inside a virtual machine this is not offered - the guest tools that make the screen resize and the clipboard work are installed there on their own."
msgstr "Betreibt virtuelle Maschinen auf diesem Rechner: QEMU und libvirt, auf einem Desktop mit dem Fenster Virtual Machine Manager. In einer virtuellen Maschine wird das nicht angeboten - dort werden die Gastwerkzeuge, mit denen sich die Bildschirmgröße anpasst und die Zwischenablage funktioniert, von selbst installiert."

#. ARCH_OS_DESKTOP: the question
#: module.yaml
msgid "Environment"
msgstr "Umgebung"

#. ARCH_OS_DESKTOP: what it means
#: module.yaml
msgid "gnome installs the GNOME desktop environment. none leaves the system on a text console, with nothing graphical installed."
msgstr "gnome installiert die Desktop-Umgebung GNOME. none belässt das System bei einer Textkonsole, ohne dass etwas Grafisches installiert wird."

#. ARCH_OS_DESKTOP_KEYBOARD_LAYOUT: the question
#: module.yaml
msgid "Desktop keyboard"
msgstr "Desktop-Tastatur"

#. ARCH_OS_DESKTOP_KEYBOARD_LAYOUT: what it means
#: module.yaml
msgid "The keyboard layout the desktop starts with. auto matches the console keyboard, using the desktop's own naming: de-latin1 and de are the same layout."
msgstr "Die Tastaturbelegung, mit der der Desktop startet. auto folgt der Konsolentastatur, in der eigenen Schreibweise des Desktops: de-latin1 und de sind dieselbe Belegung."

#. ARCH_OS_DESKTOP_KEYBOARD_VARIANT: the question
#: module.yaml
msgid "Keyboard variant"
msgstr "Tastaturvariante"

#. ARCH_OS_DESKTOP_KEYBOARD_VARIANT: what it means
#: module.yaml
msgid "A variation of that layout, such as dead keys or a different punctuation arrangement. none is the standard one."
msgstr "Eine Abwandlung dieser Belegung, etwa tote Tasten oder eine andere Anordnung der Satzzeichen. none ist die Standardvariante."

#. ARCH_OS_DESKTOP_KEYBOARD_MODEL: the question
#: module.yaml
msgid "Keyboard model"
msgstr "Tastaturmodell"

#. ARCH_OS_DESKTOP_KEYBOARD_MODEL: what it means
#: module.yaml
msgid "The physical shape of the keyboard. pc105 fits almost every keyboard sold."
msgstr "Die Bauform der Tastatur. pc105 passt auf fast jede erhältliche Tastatur."

#. ARCH_OS_DESKTOP_EXTRAS_ENABLED: the question
#: module.yaml
msgid "Desktop extras"
msgstr "Desktop-Extras"

#. ARCH_OS_DESKTOP_EXTRAS_ENABLED: what it means
#: module.yaml
msgid "Codecs, fonts, printing, network protocols, development tools and the applications that make the desktop usable straight away."
msgstr "Codecs, Schriften, Druck, Netzwerkprotokolle, Entwicklungswerkzeuge und die Programme, die den Desktop sofort brauchbar machen."

#. ARCH_OS_DESKTOP_SLIM_ENABLED: the question
#: module.yaml
msgid "Slim desktop"
msgstr "Schlanker Desktop"

#. ARCH_OS_DESKTOP_SLIM_ENABLED: what it means
#: module.yaml
msgid "Removes the GNOME applications that come with the desktop and are rarely used."
msgstr "Entfernt die GNOME-Programme, die mit dem Desktop kommen und selten benutzt werden."

#. ARCH_OS_EXTENSION_MANAGER_ENABLED: the question
#: module.yaml
msgid "Extension Manager"
msgstr "Extension Manager"

#. ARCH_OS_EXTENSION_MANAGER_ENABLED: what it means
#: module.yaml
msgid "Finds, installs and updates GNOME extensions in one window, in place of the Extensions app GNOME ships, which only switches them on and off."
msgstr "Sucht, installiert und aktualisiert GNOME-Erweiterungen in einem Fenster, anstelle der Erweiterungen-App von GNOME, die sie nur ein- und ausschaltet."

#. ARCH_OS_BROWSER: the question
#: module.yaml
msgid "Web browser"
msgstr "Webbrowser"

#. ARCH_OS_BROWSER: what it means
#: module.yaml
msgid "Installed in the language of this system and opened for every link. epiphany is GNOME Web, the desktop's own. vivaldi comes with the codecs for proprietary video. none installs no browser."
msgstr "Wird in der Sprache dieses Systems installiert und öffnet jeden Link. epiphany ist GNOME Web, der Browser des Desktops. vivaldi bringt die Codecs für proprietäre Videoformate mit. none installiert keinen Browser."

#. ARCH_OS_BACKUP: the question
#: module.yaml
msgid "Backup"
msgstr "Datensicherung"

#. ARCH_OS_BACKUP: what it means
#: module.yaml
msgid "An application that backs up your files on a schedule, to an external drive or a server, and restores them. none installs neither."
msgstr "Ein Programm, das deine Dateien regelmäßig auf ein externes Laufwerk oder einen Server sichert und sie wiederherstellt. none installiert keines von beiden."

#. ARCH_OS_FLATPAK_ENABLED: the question
#: module.yaml
msgid "Flatpak"
msgstr "Flatpak"

#. ARCH_OS_FLATPAK_ENABLED: what it means
#: module.yaml
msgid "Applications from Flathub, installed and updated through Bazaar or Software."
msgstr "Anwendungen von Flathub, installiert und aktualisiert über Bazaar oder Software."

#. ARCH_OS_BAZAAR_ENABLED: the question
#: module.yaml
msgid "Bazaar"
msgstr "Bazaar"

#. ARCH_OS_BAZAAR_ENABLED: what it means
#: module.yaml
msgid "A store made for Flathub, in place of GNOME Software. With the desktop extras, firmware updates then come from GNOME Firmware."
msgstr "Ein Store eigens für Flathub, anstelle von GNOME Software. Mit den Desktop-Extras kommen Firmware-Updates dann aus GNOME Firmware."

#. ARCH_OS_SAMBA_SHARE_ENABLED: the question
#: module.yaml
msgid "File sharing"
msgstr "Dateifreigabe"

#. ARCH_OS_SAMBA_SHARE_ENABLED: what it means
#: module.yaml
msgid "Shares your home folder and a public folder with Windows and macOS, on networks marked as home. Anyone on such a network can try your password against it. Without the firewall, every network reaches it."
msgstr "Gibt dein Benutzerverzeichnis und einen öffentlichen Ordner für Windows und macOS frei, in Netzen, die als Heimnetz markiert sind. Jeder in einem solchen Netz kann dort dein Passwort ausprobieren. Ohne Firewall erreicht sie jedes Netz."

#. the header's status, while its check says yes
#: ../../oak.yaml
msgid "Online"
msgstr "Online"

#. the header's status, while its check says no
#: ../../oak.yaml
msgid "Offline"
msgstr "Offline"

#. the step, as the run lists it
#: tasks/@prepare/mirrors/task.yaml
msgid "Rank mirrors and refresh the keyring"
msgstr "Mirrors sortieren, Keyring aktualisieren"

#. the step, as the run lists it
#: tasks/@prepare/recovery-image/task.yaml
msgid "Provide the Recovery image"
msgstr "Recovery-Abbild bereitstellen"

#. the step, as the run lists it
#: tasks/@prepare/partition/task.yaml
msgid "Partition and format the disk"
msgstr "Datenträger partitionieren und formatieren"

#. the step, as the run lists it
#: tasks/@system/pacstrap/task.yaml
msgid "Install the base system"
msgstr "Basissystem installieren"

#. the step, as the run lists it
#: tasks/@system/config/task.yaml
msgid "Set locale, time zone and hostname"
msgstr "Locale, Zeitzone und Hostname setzen"

#. the step, as the run lists it
#: tasks/@system/tweaks/task.yaml
msgid "Apply the core tweaks"
msgstr "Core Optimierungen anwenden"

#. the step, as the run lists it
#: tasks/@system/bootloader/task.yaml
msgid "Install the boot loader"
msgstr "Bootloader installieren"

#. the step, as the run lists it
#: tasks/@system/recovery/task.yaml
msgid "Write the Recovery partition"
msgstr "Recovery-Partition schreiben"

#. the step, as the run lists it
#: tasks/@system/user/task.yaml
msgid "Create the user account"
msgstr "Benutzerkonto anlegen"

#. the step, as the run lists it
#: tasks/@features/containers/task.yaml
msgid "Install the container engine"
msgstr "Container-Engine installieren"

#. the step, as the run lists it
#: tasks/@features/editor/task.yaml
msgid "Set up the text editor"
msgstr "Texteditor einrichten"

#. the step, as the run lists it
#: tasks/@features/firewall/task.yaml
msgid "Set up firewalld"
msgstr "firewalld einrichten"

#. the step, as the run lists it
#: tasks/@features/housekeeping/task.yaml
msgid "Enable the maintenance timers"
msgstr "Wartungs-Timer aktivieren"

#. the step, as the run lists it
#: tasks/@features/multilib/task.yaml
msgid "Enable the multilib repository"
msgstr "Multilib-Repository aktivieren"

#. the step, as the run lists it
#: tasks/@features/aur/task.yaml
msgid "Install the AUR helper"
msgstr "AUR-Helfer installieren"

#. the step, as the run lists it
#: tasks/@features/bootsplash/task.yaml
msgid "Install Plymouth"
msgstr "Plymouth installieren"

#. the step, as the run lists it
#: tasks/@features/manager/task.yaml
msgid "Install Arch OS Manager"
msgstr "Arch OS Manager installieren"

#. the step, as the run lists it
#: tasks/@features/shell/task.yaml
msgid "Set up zsh and the shell tools"
msgstr "zsh und Shell-Tools einrichten"

#. the step, as the run lists it
#: tasks/@features/ssh/task.yaml
msgid "Enable sshd"
msgstr "sshd aktivieren"

#. the step, as the run lists it
#: tasks/@features/vm-guest/task.yaml
msgid "Install the VM guest tools"
msgstr "VM-Gasttools installieren"

#. the step, as the run lists it
#: tasks/@features/vm-host/task.yaml
msgid "Install QEMU and libvirt"
msgstr "QEMU und libvirt installieren"

#. the step, as the run lists it
#: tasks/@desktop/gnome/task.yaml
msgid "Install GNOME"
msgstr "GNOME installieren"

#. the step, as the run lists it
#: tasks/@desktop/backup/task.yaml
msgid "Install the backup application"
msgstr "Datensicherung installieren"

#. the step, as the run lists it
#: tasks/@desktop/browser/task.yaml
msgid "Install the web browser"
msgstr "Webbrowser installieren"

#. the step, as the run lists it
#: tasks/@desktop/flatpak/task.yaml
msgid "Set up Flatpak"
msgstr "Flatpak einrichten"

#. the step, as the run lists it
#: tasks/@desktop/graphics/task.yaml
msgid "Install the graphics drivers"
msgstr "Grafiktreiber installieren"

#. the step, as the run lists it
#: tasks/@desktop/recovery-app/task.yaml
msgid "Add the Recovery to the applications"
msgstr "Recovery zu den Anwendungen hinzufügen"

#. the step, as the run lists it
#: tasks/@desktop/samba/task.yaml
msgid "Set up Samba"
msgstr "Samba einrichten"

#. the step, as the run lists it
#: tasks/@finish/first-login/task.yaml
msgid "Prepare the first login"
msgstr "Erste Anmeldung vorbereiten"

#. the step, as the run lists it
#: tasks/@finish/orphans/task.yaml
msgid "Remove orphaned packages"
msgstr "Verwaiste Pakete entfernen"

#. the step, as the run lists it
#: tasks/@finish/snapper/task.yaml
msgid "Set up Snapper"
msgstr "Snapper einrichten"

#. the step, as the run lists it
#: tasks/@finish/secure-boot/task.yaml
msgid "Sign the boot files with sbctl"
msgstr "Boot-Dateien mit sbctl signieren"

#. the step, as the run lists it
#: tasks/@finish/copy-config/task.yaml
msgid "Copy the answers and the log into the system"
msgstr "Antworten und Log ins System kopieren"

#. read once the step is done, and held on until somebody has
#: tasks/@finish/copy-config/task.yaml
msgid ""
"Arch OS is installed\n"
"\n"
"{{ARCH_OS_HOSTNAME}} is on {{ARCH_OS_DISK}} and ready to start."
msgstr ""
"Arch OS ist installiert\n"
"\n"
"{{ARCH_OS_HOSTNAME}} liegt auf {{ARCH_OS_DISK}} und ist startbereit. Alles Weitere ist optional."

#. an action: its row, and the heading over its page
#: actions/chroot/action.yaml
msgid "Open a shell"
msgstr "Shell öffnen"

#. an action: what it does, under its row
#: actions/chroot/action.yaml
msgid "Inside the system on the disk, to look around or fix something by hand. Leave it with exit."
msgstr "Im System auf dem Datenträger, um dich umzusehen oder etwas von Hand zu reparieren. Verlassen mit exit."

#. an action: what a no from it means
#: actions/import-config/action.yaml
msgid "No Arch OS configuration could be loaded from {{ARCH_OS_CONFIG_SOURCE}}. Check the code, and that this machine is online."
msgstr "Unter {{ARCH_OS_CONFIG_SOURCE}} ließ sich keine Arch-OS-Konfiguration laden. Prüfe den Code und ob diese Maschine online ist."

#. ARCH_OS_CONFIG_SOURCE: the page of the action
#: actions/import-config/action.yaml
msgid "Configuration code"
msgstr "Konfigurations-Code"

#. ARCH_OS_CONFIG_SOURCE: what it means
#: actions/import-config/action.yaml
msgid "The code of a shared configuration: the short word at the end of a paste.rs address, or the whole address. Every answer it contains can still be changed afterwards."
msgstr "Der Code einer geteilten Konfiguration: das kurze Wort am Ende einer paste.rs-Adresse oder die ganze Adresse. Jede darin enthaltene Antwort lässt sich danach noch ändern."

#. ARCH_OS_CONFIG_SOURCE: what a wrong answer is told
#: actions/import-config/action.yaml
msgid "A code such as aBc12, or the whole address it belongs to."
msgstr "Ein Code wie aBc12 — oder die vollständige Adresse dazu."

#. an action: its row, and the heading over its page
#: actions/internet/action.yaml
msgid "Internet"
msgstr "Internet"

#. an action: what a no from it means
#: actions/internet/action.yaml
msgid "There is no internet connection. Plug in a cable and it carries on by itself."
msgstr "Es gibt keine Internetverbindung. Steck ein Kabel ein, dann geht es von selbst weiter."

#. an action: its row, and the heading over its page
#: actions/live-image/action.yaml
msgid "An Arch Linux live image"
msgstr "Ein Arch-Linux-Live-Image"

#. an action: what a no from it means
#: actions/live-image/action.yaml
msgid "This runs from a booted Arch Linux live image. Write one with Create boot medium, start the machine from it, and open this there."
msgstr "Das läuft auf einem gestarteten Arch-Linux-Live-Image. Schreib eins mit Bootmedium erstellen, starte die Maschine davon und öffne es dort."

#. an action: its row, and the heading over its page
#: actions/restart/action.yaml
msgid "Restart"
msgstr "Neu starten"

#. an action: what it does, under its row
#: actions/restart/action.yaml
msgid "Close this machine down and start it again."
msgstr "Den Rechner herunterfahren und neu starten."

#. an action: its row, and the heading over its page
#: actions/root/action.yaml
msgid "Running as root"
msgstr "Läuft als root"

#. an action: what a no from it means
#: actions/root/action.yaml
msgid "This has to run as root. Log in as root and start it again."
msgstr "Das muss als root laufen. Melde dich als root an und starte es erneut."

#. an action: its row, and the heading over its page
#: actions/secure-boot-off/action.yaml
msgid "Secure Boot off"
msgstr "Secure Boot aus"

#. an action: what a no from it means
#: actions/secure-boot-off/action.yaml
msgid "Secure Boot is switched on. Turn it off in the firmware settings and start again - the installer can set it up again for you afterwards."
msgstr "Secure Boot ist eingeschaltet. Schalte es in den Firmware-Einstellungen aus und starte neu - der Installer kann es dir danach wieder einrichten."

#. an action: its row, and the heading over its page
#: actions/share-config/action.yaml
msgid "Share the configuration"
msgstr "Konfiguration teilen"

#. an action: what it does, under its row
#: actions/share-config/action.yaml
msgid "Put these answers online at paste.rs, to set up another machine exactly like this one. Anyone with the address can read them; the password is not among them."
msgstr "Stellt diese Antworten auf paste.rs online, um eine weitere Maschine genauso einzurichten. Jede Person mit der Adresse kann sie lesen; das Passwort ist nicht darunter."

#. an action: what a no from it means
#: actions/share-config/action.yaml
msgid "The configuration could not be put online. Is this machine online?"
msgstr "Die Konfiguration ließ sich nicht online stellen. Ist diese Maschine online?"

#. read once the action is done, and held on until somebody has
#: actions/share-config/action.yaml
msgid ""
"Configuration shared\n"
"\n"
"Scan the code, or type the word at the end of the address into the online starting point of another installation."
msgstr ""
"Konfiguration geteilt\n"
"\n"
"Scanne den Code — oder tippe das Wort am Ende der Adresse beim paste.rs-Startpunkt einer weiteren Installation ein."

#. an action: its row, and the heading over its page
#: actions/share-log/action.yaml
msgid "Share the log"
msgstr "Log teilen"

#. an action: what it does, under its row
#: actions/share-log/action.yaml
msgid "Put the log of this run online at paste.rs for whoever is helping. Anyone with the address can read it; passwords are never in it."
msgstr "Stellt das Log dieses Laufs auf paste.rs online, für die Person, die dir hilft. Jede Person mit der Adresse kann es lesen; Passwörter stehen nie darin."

#. an action: what a no from it means
#: actions/share-log/action.yaml
msgid "The log could not be put online. Is this machine online?"
msgstr "Das Log ließ sich nicht online stellen. Ist diese Maschine online?"

#. read once the action is done, and held on until somebody has
#: actions/share-log/action.yaml
msgid ""
"Log shared\n"
"\n"
"Scan the code, or read the address under it, and hand it to whoever is helping."
msgstr ""
"Log geteilt\n"
"\n"
"Scanne den Code oder lies die Adresse darunter und gib sie an die Person, die dir hilft."

#. an action: its row, and the heading over its page
#: actions/shutdown/action.yaml
msgid "Shut down"
msgstr "Herunterfahren"

#. an action: what it does, under its row
#: actions/shutdown/action.yaml
msgid "Switch this machine off."
msgstr "Den Rechner ausschalten."

#. an action: its row, and the heading over its page
#: actions/uefi/action.yaml
msgid "Booted in UEFI mode"
msgstr "Im UEFI-Modus gestartet"

#. an action: what a no from it means
#: actions/uefi/action.yaml
msgid "This machine booted in BIOS mode, which Arch OS does not install to. Set the boot mode to UEFI in the firmware settings and start again."
msgstr "Diese Maschine ist im BIOS-Modus gestartet, in den Arch OS nicht installiert. Stelle den Startmodus in den Firmware-Einstellungen auf UEFI und starte neu."

#. an action: its row, and the heading over its page
#: actions/wifi/action.yaml actions/wifi-passphrase/action.yaml
msgid "Wireless network"
msgstr "WLAN"

#. an action: what it does, under its row
#: actions/wifi/action.yaml
msgid "Join a wireless network."
msgstr "Mit einem WLAN verbinden."

#. ARCH_OS_WIFI_SSID: the page of the action
#: actions/wifi/action.yaml
msgid "Network"
msgstr "Netzwerk"

#. an action: its row, and the heading over its page
#: actions/wifi-card/action.yaml
msgid "A wireless card"
msgstr "Eine WLAN-Karte"

#. an action: what a no from it means
#: actions/wifi-passphrase/action.yaml
msgid "{{ARCH_OS_WIFI_SSID}} did not accept that passphrase, or it is out of range."
msgstr "{{ARCH_OS_WIFI_SSID}} hat dieses Passwort nicht angenommen oder ist außer Reichweite."

#. ARCH_OS_WIFI_PASSPHRASE: the page of the action
#: actions/wifi-passphrase/action.yaml
msgid "Passphrase"
msgstr "Passwort"
