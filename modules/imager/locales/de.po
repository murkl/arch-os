#. the name of this language in the language itself - "Deutsch", not
#. "German". A list of languages is read by the people who speak them.
msgid "English"
msgstr "Deutsch"

#. what this module is called, wherever the interface names it
#: module.yaml
msgid "Create boot medium"
msgstr "Bootmedium erstellen"

#. ARCH_OS_DOWNLOAD_DIR: the question
#: module.yaml
msgid "Download folder"
msgstr "Download-Ordner"

#. ARCH_OS_DOWNLOAD_DIR: what it means
#: module.yaml
msgid "Where the image is kept, so a second run costs no download. It needs about two gigabytes."
msgstr "Wo das Image liegt, damit ein zweiter Lauf nichts herunterladen muss. Es braucht rund zwei Gigabyte."

#. ARCH_OS_DOWNLOAD_DIR: the heading its row sits under
#: module.yaml
msgid "Image"
msgstr "Image"

#. ARCH_OS_DOWNLOAD_DIR: what a wrong answer is told
#: module.yaml
msgid "Type the full path of a folder, starting with / or ~/."
msgstr "Gib den vollständigen Pfad eines Ordners an, beginnend mit / oder ~/."

#. ARCH_OS_IMAGE_VERIFY: the question
#: module.yaml
msgid "Verify checksum"
msgstr "Prüfsumme abgleichen"

#. ARCH_OS_IMAGE_VERIFY: what it means
#: module.yaml
msgid "Checks the image against the checksum of its release before anything is written. Off, the image in the download folder is written as it is, such as one you built yourself."
msgstr "Prüft das Image vor dem Schreiben gegen die Prüfsumme seines Releases. Ausgeschaltet wird das Image im Download-Ordner geschrieben, wie es ist, etwa ein selbst gebautes."

#. ARCH_OS_IMAGE_DEVICE: the question
#: module.yaml
msgid "Device"
msgstr "Datenträger"

#. ARCH_OS_IMAGE_DEVICE: what it means
#: module.yaml
msgid "The USB device to write to. Everything on it is erased. A device the running system is on is not offered."
msgstr "Der USB-Datenträger, auf den geschrieben wird. Alles darauf wird gelöscht. Ein Datenträger mit dem laufenden System wird nicht angeboten."

#. ARCH_OS_IMAGE_DEVICE: what a wrong answer is told
#: module.yaml
msgid "No USB device found. Plug a stick in and choose Start again."
msgstr "Kein USB-Datenträger gefunden. Steck einen Stick ein und wähle erneut Start."

#. ARCH_OS_IMAGE_SUDO: the question
#: module.yaml
msgid "Password for the write"
msgstr "Passwort zum Schreiben"

#. ARCH_OS_IMAGE_SUDO: what it means
#: module.yaml
msgid "Whether writing the device asks for your password."
msgstr "Ob das Schreiben des Datenträgers nach deinem Passwort fragt."

#. ARCH_OS_IMAGE_SUDO: the heading its row sits under
#: module.yaml
msgid "Target"
msgstr "Ziel"

#. ARCH_OS_IMAGE_PASSWORD: the question
#: module.yaml
msgid "Your password"
msgstr "Dein Passwort"

#. ARCH_OS_IMAGE_PASSWORD: what it means
#: module.yaml
msgid "Writing the device needs root, and sudo asks for your password. Asked right before the run and never written to a file."
msgstr "Das Schreiben braucht Root-Rechte, und sudo fragt dafür nach deinem Passwort. Es wird direkt vor dem Start abgefragt und nie in eine Datei geschrieben."

#. ARCH_OS_IMAGE_PASSWORD: what a wrong answer is told
#: module.yaml
msgid "That is not your password, or this account may not use sudo."
msgstr "Das ist nicht dein Passwort, oder dieses Konto darf sudo nicht verwenden."

#. told where a script stops itself with exit 3 and its own yaml has no
#. words for it
#: module.yaml
msgid ""
"No internet connection\n"
"\n"
"The image and its checksum come from the release page. Connect this machine and choose Start again."
msgstr ""
"Keine Internetverbindung\n"
"\n"
"Das Image und seine Prüfsumme kommen von der Release-Seite. Verbinde diesen Rechner und wähle erneut Start."

#. told where a script stops itself with exit 4 and its own yaml has no
#. words for it
#: module.yaml
msgid ""
"The release page does not answer\n"
"\n"
"GitHub does not hand out this release right now: try again in a few minutes. An image you built yourself is written with Verify checksum off in Setup."
msgstr ""
"Die Release-Seite antwortet nicht\n"
"\n"
"GitHub gibt dieses Release gerade nicht heraus: Versuch es in ein paar Minuten erneut. Ein selbst gebautes Image wird mit ausgeschaltetem „Prüfsumme abgleichen“ im Setup geschrieben."

#. the header's status, while its check says yes
#: ../../oak.yaml
msgid "Online"
msgstr "Online"

#. the header's status, while its check says no
#: ../../oak.yaml
msgid "Offline"
msgstr "Offline"

#. the step, as the run lists it
#: tasks/@download/image/task.yaml
msgid "Download the image"
msgstr "Image herunterladen"

#. told where the step stops itself with exit 10
#: tasks/@download/image/task.yaml
msgid ""
"The download folder cannot be used\n"
"\n"
"{{ARCH_OS_DOWNLOAD_DIR}} cannot be created or written to. Choose another Download folder in Setup."
msgstr ""
"Der Download-Ordner ist nicht nutzbar\n"
"\n"
"{{ARCH_OS_DOWNLOAD_DIR}} lässt sich nicht anlegen oder beschreiben. Wähle im Setup einen anderen Download-Ordner."

#. told where the step stops itself with exit 11
#: tasks/@download/image/task.yaml
msgid ""
"The download broke off\n"
"\n"
"The release page stopped sending the image. Choose Start again to fetch it anew."
msgstr ""
"Der Download ist abgebrochen\n"
"\n"
"Die Release-Seite hat aufgehört, das Image zu senden. Wähle erneut Start, um es neu zu laden."

#. the step, as the run lists it
#: tasks/@verify/checksum/task.yaml
msgid "Verify the checksum"
msgstr "Prüfsumme abgleichen"

#. told where the step stops itself with exit 10
#: tasks/@verify/checksum/task.yaml
msgid ""
"There is no checksum to check the image against\n"
"\n"
"Its release publishes none, and the image was not written. Turn Verify checksum off in Setup to write it unchecked."
msgstr ""
"Es gibt keine Prüfsumme für das Image\n"
"\n"
"Sein Release veröffentlicht keine, und das Image wurde nicht geschrieben. Schalte „Prüfsumme abgleichen“ im Setup aus, um es ungeprüft zu schreiben."

#. told where the step stops itself with exit 11
#: tasks/@verify/checksum/task.yaml
msgid ""
"The image is damaged\n"
"\n"
"It does not match the checksum of its release and was deleted. Choose Start again to download it anew."
msgstr ""
"Das Image ist beschädigt\n"
"\n"
"Es passt nicht zur Prüfsumme seines Releases und wurde gelöscht. Wähle erneut Start, um es neu herunterzuladen."

#. the step, as the run lists it
#: tasks/@write/device/task.yaml
msgid "Write the image to the device"
msgstr "Image auf den Datenträger schreiben"

#. read once the step is done, and held on until somebody has
#: tasks/@write/device/task.yaml
msgid ""
"The device is ready\n"
"\n"
"{{ARCH_OS_IMAGE_DEVICE}} now starts Arch OS. Unplug it, plug it into the machine to install, and start that machine from it."
msgstr ""
"Der Datenträger ist fertig\n"
"\n"
"{{ARCH_OS_IMAGE_DEVICE}} startet jetzt Arch OS. Zieh ihn ab, steck ihn in den Rechner, auf dem installiert werden soll, und starte ihn davon."

#. told where the step stops itself with exit 10
#: tasks/@write/device/task.yaml
msgid ""
"The USB stick is gone\n"
"\n"
"{{ARCH_OS_IMAGE_DEVICE}} is no longer plugged in. Plug it back in and choose Start again."
msgstr ""
"Der USB-Stick ist weg\n"
"\n"
"{{ARCH_OS_IMAGE_DEVICE}} steckt nicht mehr. Steck ihn wieder ein und wähle erneut Start."

#. told where the step stops itself with exit 11
#: tasks/@write/device/task.yaml
msgid ""
"The USB stick is too small\n"
"\n"
"The image needs more room than {{ARCH_OS_IMAGE_DEVICE}} has. Choose Start again with a larger one."
msgstr ""
"Der USB-Stick ist zu klein\n"
"\n"
"Das Image braucht mehr Platz, als {{ARCH_OS_IMAGE_DEVICE}} hat. Wähle erneut Start mit einem größeren."

#. told where the step stops itself with exit 12
#: tasks/@write/device/task.yaml
msgid ""
"The USB stick is still in use\n"
"\n"
"Something still holds {{ARCH_OS_IMAGE_DEVICE}} open. Close it, or unplug the stick and plug it in again, then choose Start again."
msgstr ""
"Der USB-Stick wird noch benutzt\n"
"\n"
"Etwas hält {{ARCH_OS_IMAGE_DEVICE}} noch offen. Schließ es oder zieh den Stick ab und steck ihn wieder ein, dann wähle erneut Start."

#. told where the step stops itself with exit 13
#: tasks/@write/device/task.yaml
msgid ""
"Writing the USB stick failed\n"
"\n"
"{{ARCH_OS_IMAGE_DEVICE}} stopped taking the image. It may be faulty or was pulled out: choose Start again, or try another stick."
msgstr ""
"Der USB-Stick ließ sich nicht beschreiben\n"
"\n"
"{{ARCH_OS_IMAGE_DEVICE}} hat aufgehört, das Image anzunehmen. Er ist womöglich defekt oder wurde abgezogen: Wähle erneut Start oder nimm einen anderen Stick."

#. an action: its row, and the heading over its page
#: actions/installed-system/action.yaml
msgid "An installed Linux system"
msgstr "Ein installiertes Linux-System"

#. an action: what a no from it means
#: actions/installed-system/action.yaml
msgid "Create boot medium runs on an installed Linux system. On the live image, open the Installer or the Recovery instead."
msgstr "Bootmedium erstellen läuft auf einem installierten Linux-System. Öffne auf dem Live-Image stattdessen den Installer oder das Recovery."

#. an action: its row, and the heading over its page
#: actions/share-log/action.yaml
msgid "Share the log"
msgstr "Log teilen"

#. an action: what it does, under its row
#: actions/share-log/action.yaml
msgid "Put the log of this run online at paste.rs for whoever is helping. Anyone with the address can read it; passwords are never in it."
msgstr "Stellt das Log dieses Laufs auf paste.rs online, für die Person, die dir hilft. Jede Person mit der Adresse kann es lesen; Passwörter stehen nie darin."

#. an action: what a no from it means
#: actions/share-log/action.yaml
msgid "paste.rs did not take the log. Try again in a moment."
msgstr "paste.rs hat das Log nicht angenommen. Versuch es gleich noch einmal."

#. read once the action is done, and held on until somebody has
#: actions/share-log/action.yaml
msgid ""
"Log shared\n"
"\n"
"Scan the code, or read the address under it, and hand it to whoever is helping."
msgstr ""
"Log geteilt\n"
"\n"
"Scanne den Code oder lies die Adresse darunter und gib sie an die Person, die dir hilft."

#. an action: its row, and the heading over its page
#: actions/sudo/action.yaml
msgid "Root for the write"
msgstr "Root zum Schreiben"

#. an action: what a no from it means
#: actions/sudo/action.yaml
msgid "Writing a device needs root, and this machine has no sudo to ask for it. Start this again as root."
msgstr "Einen Datenträger zu schreiben braucht root, und dieser Rechner hat kein sudo, um danach zu fragen. Starte es erneut als root."

#. an action: its row, and the heading over its page
#: actions/usb/action.yaml
msgid "A USB device to write to"
msgstr "Ein USB-Datenträger zum Schreiben"

#. an action: what a no from it means
#: actions/usb/action.yaml
msgid "No USB device found. Plug a stick in and this carries on by itself."
msgstr "Kein USB-Datenträger gefunden. Steck einen Stick ein, dann geht es von selbst weiter."
