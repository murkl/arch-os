# Written by Arch OS. The kernel on the encrypted root, since every rebuilt UKI
# is signed: on the EFI partition anyone could swap it.
ALL_kver="/var/lib/arch-os/vmlinuz-{{KERNEL}}"
ALL_cmdline="/etc/kernel/cmdline"
PRESETS=('default' 'fallback')
default_uki="{{DEFAULT}}"
fallback_uki="{{FALLBACK}}"
fallback_options="-S autodetect"
