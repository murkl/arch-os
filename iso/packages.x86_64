# Added to the Recovery's packages, which the ISO runs too. What the Installer
# calls on the live system is named, and build.sh checks the commands.
dosfstools
efibootmgr
gptfdisk
parted
reflector
xkeyboard-config

# CPU microcode in the initramfs, as releng loads it.
amd-ucode
intel-ucode

# The Arch ISO's other ways online: rare Wi-Fi chips, server cards, Thunderbolt
# docks, iPhone tethering and mobile broadband.
linux-firmware-other
bolt
usbmuxd
modemmanager
usb_modeswitch

# root's shell and an editor on the other consoles, as releng ships them.
zsh
grml-zsh-config
nano

# The speech boot entry: screen reader, sound and sound firmware.
alsa-utils
brltty
espeakup
livecd-sounds
sof-firmware
linux-firmware-cirrus
linux-firmware-ti

# For e2e.sh: ssh into the live system, tmux to read the interface.
openssh
tmux
