#!/usr/bin/env bash
# Start Arch OS. The systemd unit on tty1 runs this, and so do `installer` and
# `recovery` beside it, which are the same run with the module already named.
#
# The console is dressed right before the interface draws on it: the font decides
# which glyphs exist, the palette what the sixteen colour slots look like. Not in
# the unit, because an ExecStartPre runs while the boot splash still holds the
# console and setfont finds nothing to load into. Neither is worth refusing to
# start over, so both may fail.
#
# Oak looks for oak.yaml and the modules folder beside its own binary, so it is
# started out of the folder it was installed into - every answer file and log
# then lands beside them, and starting it again from any prompt picks up where it
# left off.
set -eu

setfont Lat2-Terminus16 || true
arch-os-console-theme || true

cd /opt/arch-os
exec ./oak "$@"
