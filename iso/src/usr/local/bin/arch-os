#!/usr/bin/env bash
# Start Arch OS. The systemd unit on tty1 runs this, and so do `installer` and
# `recovery` beside it, which are the same run with the module already named.
#
# The console is dressed right before the interface draws on it: the palette
# decides what the sixteen colour slots look like, and goes first so the console
# comes up in the colour the boot splash left; the font decides which glyphs
# exist. Not in the unit, because an ExecStartPre runs while the boot splash
# still holds the console and setfont finds nothing to load into. Neither is
# worth refusing to start over, so both may fail.
#
# The font is Terminus Bold, built by iso/font.sh, in the largest of these sizes
# that leaves the interface no more than 1/φ of the screen each way, and in the
# smallest where none does - see iso/README.md. `make glyphs-check` holds every
# one to what this image puts on the console.
#
# Oak looks for oak.yaml and the modules folder beside its own binary, so it is
# started out of the folder it was installed into - every answer file and log
# then lands beside them, and starting it again from any prompt picks up where it
# left off.
set -eu

SIZES="32 24 20 18"

# The interface is 95 columns by 25 rows; times φ, that is the screen it needs.
COLS=154 ROWS=40

arch-os-console-theme || true

# Only on a console: a terminal in a window has its font already. fbcon takes the
# console over on the first character drawn on it that is not a space, and until
# then there is none for setfont to load into. So a dot is drawn and taken back
# at once, and the load is tried for two seconds.
if [[ "$(tty)" == /dev/tty[0-9]* ]]; then
    read -ra sizes <<<"$SIZES"
    width=0 height=0
    IFS=, read -r width height </sys/class/graphics/fb0/virtual_size || true
    for size in "${sizes[@]}"; do
        [ $((width / (size / 2))) -ge "$COLS" ] && [ $((height / size)) -ge "$ROWS" ] && break
    done

    printf '.\b \b'
    loaded=false
    for _ in $(seq 20); do
        if error="$(setfont "arch-os-${size}" 2>&1)"; then
            loaded=true
            break
        fi
        sleep 0.1
    done
    "$loaded" || echo "$error" >&2
fi

cd /opt/arch-os
exec ./oak "$@"
