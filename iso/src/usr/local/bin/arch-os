#!/usr/bin/env bash
# Start Arch OS. The systemd unit on tty1 runs this, and so do `installer` and
# `recovery` beside it, which are the same run with the module already named.
#
# The console's palette is the kernel's, set on the command line in
# iso/build.sh. The font is set here, right before the interface draws: it
# decides which glyphs exist. Not worth refusing to start over, so it may fail.
#
# The font is Terminus Bold, built by iso/font.sh, in the size the kernel picks
# for its own font, as a stock Arch ISO shows it - see iso/README.md.
# `make glyphs-check` holds every one to what this image puts on the console.
#
# Oak looks for oak.yaml and the modules folder beside its own binary, so it is
# started out of the folder it was installed into - every answer file and log
# then lands beside them, and starting it again from any prompt picks up where it
# left off.
set -eu

SIZES="32 16"

# Only on a console: a terminal in a window has its font already. 8 by 16, and
# 16 by 32 where 8 by 16 would leave 22,000 cells or more: the kernel's rule
# between the two fonts Arch builds it with (lib/fonts/fonts.c).
if [[ "$(tty)" == /dev/tty[0-9]* ]]; then
    read -r large size <<<"$SIZES"
    width=0 height=0
    IFS=, read -r width height </sys/class/graphics/fb0/virtual_size || true
    cols=$((width / 8)) rows=$((height / 16))
    if [ $((cols * rows)) -ge 22000 ]; then
        size="$large"
    fi
    setfont "arch-os-${size}" || true
fi

# Plymouth locks a console's settings while it holds it, and a lock left behind
# keeps every key on the screen rather than handing it on. stty reads its change
# back, so a locked terminal ends here instead of in an interface that cannot be
# worked.
if [ -t 0 ]; then
    saved="$(stty -g)"
    stty raw -echo || {
        echo "Error: this terminal's settings are locked, so no key would reach Arch OS" >&2
        exit 1
    }
    stty "$saved"
fi

cd /opt/arch-os
exec ./oak "$@"
