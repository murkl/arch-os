#!/usr/bin/env bash
# Start the installer. The way in on this image — the systemd unit on tty1 runs
# this, and so does anybody typing `installer` at a prompt after leaving it.
# Repairing an installation is the other program, `recovery`, beside this one.
#
# Three things it settles, and they are why it is a script rather than a symlink:
#
# The console is dressed the moment before the interface draws on it — the font
# decides which glyphs exist, the palette what the sixteen colour slots look
# like. Not in the unit, because an ExecStartPre runs while the boot splash still
# holds the console and setfont finds none to load into. Doing it here is also
# what gives somebody who leaves and types `installer` again the same console
# back. Neither is worth refusing to start over, so both may fail.
#
# The runtime looks for a tree beside its own binary, so it is started out of the
# folder it was installed into — and installer.conf and installer.log then land
# beside that tree, so starting it again from any prompt picks up where it left
# off.
set -eu

setfont Lat2-Terminus16 || true
installer-console-theme || true

cd /opt/installer
exec ./installer "$@"
