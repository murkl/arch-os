[Unit]
Description=Arch OS Installer
# Plymouth owns the console until it is told to go; starting before it does
# means drawing underneath the splash.
After=plymouth-quit-wait.service systemd-user-sessions.service
# The installer needs tty1 to itself. Conflicting with the getty is what takes
# it, rather than fighting a login prompt for the same terminal.
Conflicts=getty@tty1.service
After=getty@tty1.service

# Whatever becomes of the installer, this console is handed back to a login
# shell rather than left as the blank screen the installer was drawing on.
#
# On success that is somebody choosing to leave the installer: the way out that
# keeps the machine running, offered beside restart and shut down. They wanted a
# console and this is it, with /etc/motd saying how to get back.
#
# On failure it is the same console for the opposite reason — the installer
# crashed, was killed, could not start — and it is exactly then that somebody
# needs a root prompt in front of them: to read the log, to mount a disk, to try
# again. A machine that answers nothing is the one outcome this image must not
# have.
OnSuccess=getty@tty1.service
OnFailure=getty@tty1.service

# Three goes inside a minute, then the console goes to the getty above. Without
# a bound, an installer that dies the moment it starts would restart for ever
# and never reach OnFailure.
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# idle keeps the first frame from being drawn over by the tail of the boot log.
Type=idle
# The console font decides which glyphs exist at all, and the palette decides
# what the sixteen colour slots look like. Both are set here rather than in
# vconsole.conf, because vconsole.conf applies to every tty and this is about
# the one the installer draws on.
#
# A console font holds at most 512 glyphs and this one is no exception, so the
# interface draws itself out of what it has — see tui/glyphs.go in the runtime.
ExecStartPre=-/usr/bin/setfont Lat2-Terminus16
ExecStartPre=-/usr/local/bin/installer-console-theme
# The same command the user types at the prompt, so a run started by this
# machine and one started by hand are the same run — see the script itself.
ExecStart=/usr/local/bin/installer
Restart=on-failure
RestartSec=2

StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

# The installer is the reason this machine booted, and stopping it is a
# decision rather than an accident: what follows either way is the console
# above.
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target
