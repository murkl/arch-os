[Unit]
Description=Arch OS
# After the boot splash, as getty@.service starts: resetting tty1 under Plymouth
# leaves its lock behind, and no key reaches the interface.
After=systemd-user-sessions.service plymouth-quit-wait.service rc-local.service
# It needs tty1 to itself. Conflicting with the getty is what takes it, rather
# than fighting a login prompt for the same terminal.
Conflicts=getty@tty1.service
After=getty@tty1.service

# Whatever becomes of it, tty1 goes back to a login instead of a blank screen:
# a machine that answers nothing is the one outcome this image must not have.
OnSuccess=getty@tty1.service
OnFailure=getty@tty1.service

# Not restarted: an interface that comes back by itself hides a crash over a
# half-written disk. `journalctl -b -u arch-os` says what happened.

[Service]
# Not idle: idle holds the interface back until the rest of the boot is
# dispatched, up to five seconds of an empty screen.
Type=simple
# The Installer is what this image is for; `recovery` on another console starts
# the Recovery.
ExecStart=/usr/local/bin/installer

StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

# This is the reason the machine booted, and stopping it is a decision rather
# than an accident.
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target
