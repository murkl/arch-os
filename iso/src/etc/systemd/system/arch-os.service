[Unit]
Description=Arch OS
# It ends the boot splash itself, the way gdm.service does, so the splash stays
# up until the interface is about to draw: plymouth-quit.service would end it
# first and leave a black screen in between. The ordering is what that unit
# would have waited for.
Conflicts=plymouth-quit.service
After=plymouth-quit.service rc-local.service plymouth-start.service systemd-user-sessions.service
# It needs tty1 to itself. Conflicting with the getty is what takes it, rather
# than fighting a login prompt for the same terminal.
Conflicts=getty@tty1.service
After=getty@tty1.service

# Whatever becomes of it, this console is handed back to a login shell rather
# than left as the blank screen it was drawing on. On success that is somebody
# choosing to leave, with /etc/motd saying how to get back; on failure it is a
# root prompt for reading the log and trying again, behind a splash that is
# ended for it. A machine that answers nothing is the one outcome this image
# must not have.
OnSuccess=getty@tty1.service
OnFailure=getty@tty1.service plymouth-quit.service

# On the first failure, not after a few tries at starting over. An interface
# that comes back by itself cannot be told from one that was never away, so a
# crash would read as the installation having restarted - while the run behind
# it may have left a half-written disk and an open LUKS device. It stops here
# instead, and `journalctl -b -u arch-os` says what happened.

[Service]
# Not idle: idle waits up to five seconds for the other jobs, among them the
# gettys' plymouth-quit-wait.service, which waits for the line below. Measured
# under QEMU, that was five seconds of black screen.
Type=simple
# Its last frame stays on screen until the console draws over it.
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
# The Installer is what this image is for; the Recovery is on every installed
# system, and `recovery` on another console starts it here too. A run started
# by this machine and one started by hand are the same run.
ExecStart=/usr/local/bin/installer

StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

# This is the reason the machine booted, and stopping it is a decision rather
# than an accident.
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target
