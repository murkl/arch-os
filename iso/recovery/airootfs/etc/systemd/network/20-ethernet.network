# Wired network at boot, since a plugged cable asks for it. systemd-networkd and
# systemd-resolved are enabled in ../system/. Metrics as on the Arch ISO, so the
# cable carries the traffic when both are up.
[Match]
Type=ether
Kind=!*

[Network]
DHCP=yes

[DHCPv4]
RouteMetric=100

[IPv6AcceptRA]
RouteMetric=100
