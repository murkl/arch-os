#!/usr/bin/env bash
# Seeds the answers of the Recovery partition once per boot: language, keyboard
# and disk. What cannot be read is asked instead.
set -eu

OPT=/opt/arch-os

# Written by installer/tasks/recovery, which spells the same path.
SEED=EFI/arch-os-recovery/recovery.conf

# The script every installed system runs after a good start. build.sh passes
# BOOT_TRIES from lib.sh.
BOOT_TRIES_SCRIPT=/usr/local/lib/arch-os/boot-tries.sh
: "${BOOT_TRIES:?set by arch-os-seed.service.d/tries.conf}"

# Set by systemd-boot, or by the stub of a UKI the firmware started, to the EFI
# partition booted from.
LOADER_DEVICE=/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f

# The EFI partition booted from. Not the Recovery partition the initramfs found
# by UUID: every installation of a release shares it, so with two disks it may
# be the other. Empty on other boots, as in the smoke test. Read to the end, so
# lsblk is never cut off mid-line.
booted_esp() {
    local uuid
    [ -r "$LOADER_DEVICE" ] || return 0
    uuid="$(tail -c +5 "$LOADER_DEVICE" | tr -d '\0' | tr '[:upper:]' '[:lower:]')"
    [[ $uuid =~ ^[0-9a-f-]+$ ]] || return 0
    lsblk -rno PATH,PARTUUID | awk -v uuid="$uuid" '!found && $2 == uuid { print $1; found = 1 }'
}

rm -f "${OPT}/recovery.conf"

# The disk of that partition holds the system to repair.
esp="$(booted_esp)"
disk=""
if [ -n "$esp" ]; then
    disk="$(lsblk -dno PKNAME "$esp")"
    [ -z "$disk" ] || disk="/dev/${disk}"
fi

# Mounted briefly, since the Recovery may write to it. Resetting the tries makes
# the next start try the system again.
if [ -n "$esp" ]; then
    mnt="$(mktemp -d)"
    # Checked first, as mount_esp in lib.sh does, since the tries are written
    # there next.
    fsck.fat -a "$esp" || [ "$?" -eq 1 ] || echo "checking the EFI partition ${esp} failed" >&2
    if mount -t vfat "$esp" "$mnt"; then
        [ ! -f "${mnt}/${SEED}" ] || cp "${mnt}/${SEED}" "${OPT}/recovery.conf"
        if ! "$BOOT_TRIES_SCRIPT" "$mnt" "$BOOT_TRIES"; then
            echo "resetting the tries of the boot entries failed" >&2
        fi
        umount "$mnt"
    else
        echo "cannot mount the EFI partition ${esp}, the Recovery asks instead" >&2
    fi
    rmdir "$mnt"
else
    echo "boot partition unknown, the Recovery asks for the disk" >&2
fi

# Derived here, not seeded: a name like /dev/sda holds for one boot only.
[ -z "$disk" ] || printf "ARCH_OS_RECOVERY_DISK='%s'\n" "$disk" >>"${OPT}/recovery.conf"
