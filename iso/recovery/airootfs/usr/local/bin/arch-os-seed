#!/usr/bin/env bash
# The answers the Recovery on its own partition opens on: the language the
# system was installed in, the keyboard it was typed on and the disk it was
# started from. Once a boot, by arch-os-seed.service, so every later start of
# the Recovery finds the answers as the last one left them. What cannot be read
# is asked the ordinary way instead, and said in the journal.
set -eu

OPT=/opt/arch-os

# What the Installer leaves on the EFI partition: Oak's own answers and the
# Recovery's. modules/installer/tasks/@system/recovery spells the same path.
SEED=EFI/arch-os-recovery

# The partition this was started from, found the way the ram disk found it: by
# the UUID its command line names. Empty where it was started some other way.
booted_partition() {
    local uuid part
    uuid="$(sed -n 's/.*archisodevice=UUID=\([^ ]*\).*/\1/p' /proc/cmdline)"
    [ -n "$uuid" ] || return 0
    part="$(readlink -f "/dev/disk/by-uuid/${uuid}")"
    [ ! -b "$part" ] || printf '%s' "$part"
}

# The disk that partition lies on, which is the disk holding the system to
# repair. Empty for an image that is a whole disk of its own, which is how the
# smoke test starts it.
booted_disk() {
    local part parent
    part="$(booted_partition)"
    [ -n "$part" ] || return 0
    parent="$(lsblk -dno PKNAME "$part")"
    [ -z "$parent" ] || printf '/dev/%s' "$parent"
}

# The EFI partition on that disk, by its type rather than its number. Read to
# the end rather than left at the first, so lsblk is never cut off mid-line.
efi_partition() {
    lsblk -rno PATH,PARTTYPE "$1" |
        awk '!found && $2 == "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" { print $1; found = 1 }'
}

rm -f "${OPT}/oak.conf" "${OPT}/recovery.conf"

disk="$(booted_disk)"
esp=""
[ -z "$disk" ] || esp="$(efi_partition "$disk")"

# Read-only and only for as long as it takes: the Recovery may yet have to
# write to this partition, and it must find it as the system left it.
if [ -n "$esp" ]; then
    mnt="$(mktemp -d)"
    if mount -o ro "$esp" "$mnt"; then
        for file in oak.conf recovery.conf; do
            [ ! -f "${mnt}/${SEED}/${file}" ] || cp "${mnt}/${SEED}/${file}" "${OPT}/${file}"
        done
        umount "$mnt"
    else
        echo "the EFI partition ${esp} could not be read, the Recovery asks instead" >&2
    fi
    rmdir "$mnt"
else
    echo "started from no partition of a disk, the Recovery asks for its disk" >&2
fi

# The disk is not handed over but worked out here: a name like /dev/sda is only
# what one boot called it.
[ -z "$disk" ] || printf "ARCH_OS_RECOVERY_DISK='%s'\n" "$disk" >>"${OPT}/recovery.conf"
