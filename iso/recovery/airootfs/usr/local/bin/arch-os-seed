#!/usr/bin/env bash
# The answers the Recovery on its partition opens on, once a boot: language,
# keyboard and disk. What cannot be read is asked instead.
set -eu

OPT=/opt/arch-os

# What the Installer leaves on the EFI partition: the Recovery's answers.
# installer/tasks/system/recovery spells the same path.
SEED=EFI/arch-os-recovery/recovery.conf

# The script every installed system runs after a start that worked, with the
# count build.sh read out of lib.sh into this unit's environment.
BOOT_TRIES_SCRIPT=/usr/local/lib/arch-os/boot-tries.sh
: "${BOOT_TRIES:?set by arch-os-seed.service.d/tries.conf}"

# Where systemd's boot loader, or the stub of an image the firmware started
# itself, records the EFI partition it was started from.
LOADER_DEVICE=/sys/firmware/efi/efivars/LoaderDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f

# The EFI partition this was started from. Not the partition the ram disk found
# by its UUID: every installation of one release has that UUID, so with two
# disks it may be the other one. Empty where it was started some other way, as
# the smoke test starts it. Read to the end, so lsblk is never cut off mid-line.
booted_esp() {
    local uuid
    [ -r "$LOADER_DEVICE" ] || return 0
    uuid="$(tail -c +5 "$LOADER_DEVICE" | tr -d '\0' | tr '[:upper:]' '[:lower:]')"
    [[ $uuid =~ ^[0-9a-f-]+$ ]] || return 0
    lsblk -rno PATH,PARTUUID | awk -v uuid="$uuid" '!found && $2 == uuid { print $1; found = 1 }'
}

rm -f "${OPT}/recovery.conf"

# The disk that partition lies on holds the system to repair.
esp="$(booted_esp)"
disk=""
if [ -n "$esp" ]; then
    disk="$(lsblk -dno PKNAME "$esp")"
    [ -z "$disk" ] || disk="/dev/${disk}"
fi

# Only briefly, since the Recovery may write to it itself. The entries get their
# tries back, so the next start tries the system again.
if [ -n "$esp" ]; then
    mnt="$(mktemp -d)"
    if mount -t vfat "$esp" "$mnt"; then
        [ ! -f "${mnt}/${SEED}" ] || cp "${mnt}/${SEED}" "${OPT}/recovery.conf"
        if ! "$BOOT_TRIES_SCRIPT" "$mnt" "$BOOT_TRIES"; then
            echo "the system's boot entries could not be given their tries back" >&2
        fi
        umount "$mnt"
    else
        echo "the EFI partition ${esp} could not be mounted, the Recovery asks instead" >&2
    fi
    rmdir "$mnt"
else
    echo "started from no partition of a disk, the Recovery asks for its disk" >&2
fi

# The disk is not handed over but worked out here: a name like /dev/sda is only
# what one boot called it.
[ -z "$disk" ] || printf "ARCH_OS_RECOVERY_DISK='%s'\n" "$disk" >>"${OPT}/recovery.conf"
