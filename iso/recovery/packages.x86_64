# The Recovery's packages and nothing else: no editor, no firmware but the
# wireless cards', see Recovery Partition in docs/REFERENCE.md. What its scripts
# call is named rather than left to base, and build.sh checks the commands.
arch-install-scripts
base
btrfs-progs
cryptsetup
curl
iproute2
jq
kbd
linux
mkinitcpio
mkinitcpio-archiso
plymouth
psmisc

# Wi-Fi on demand: iwd starts once a card is asked for, see wifi_station in
# lib.sh. Firmware of the default set's wireless cards, pacman.conf drops the
# rest of those packages.
iwd
wireless-regdb
linux-firmware-atheros
linux-firmware-broadcom
linux-firmware-intel
linux-firmware-mediatek
linux-firmware-realtek
