[Unit]
Description=Arch OS
# After the splash, like getty@.service: resetting tty1 under Plymouth leaves
# its lock behind and blocks every key.
After=systemd-user-sessions.service plymouth-quit-wait.service rc-local.service
# Takes tty1 from the getty instead of sharing it with a login prompt.
Conflicts=getty@tty1.service
After=getty@tty1.service

# tty1 falls back to a login on any exit, never to a blank screen.
OnSuccess=getty@tty1.service
OnFailure=getty@tty1.service

# No restart: coming back by itself would hide a crash over a half-written disk.
# Log: `journalctl -b -u arch-os`.

[Service]
# Not idle, which waits for the rest of the boot: up to five seconds of an
# empty screen.
Type=simple
# `arch-os recovery` on another console starts the Recovery.
ExecStart=/usr/local/bin/arch-os installer
# Set only by smoke.sh and e2e.sh, passed on as --trace by the launcher.
ImportCredential=arch-os.trace

StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

# The machine's one job, so it stops on purpose only.
KillMode=process
IgnoreSIGPIPE=no
SendSIGHUP=yes

[Install]
WantedBy=multi-user.target
