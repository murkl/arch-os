#!/usr/bin/env bash
# Starts Arch OS from the tty1 unit or by hand: arch-os installer, arch-os
# recovery. The font goes first, since it decides which glyphs exist: README.md.
set -eu

SIZES="32 16"

# Consoles only, a terminal window has its own font. 16x32 where 8x16 gives
# 22,000 cells or more, the kernel's rule for its two fonts (lib/fonts/fonts.c).
if [[ "$(tty)" == /dev/tty[0-9]* ]]; then
    read -r large size <<<"$SIZES"
    width=0 height=0
    IFS=, read -r width height </sys/class/graphics/fb0/virtual_size || true
    cols=$((width / 8)) rows=$((height / 16))
    if [ $((cols * rows)) -ge 22000 ]; then
        size="$large"
    fi
    setfont "arch-os-${size}" || true
fi

# A Plymouth lock on the console keeps every key from the program. stty reads
# its change back, so a locked terminal fails here.
if [ -t 0 ]; then
    saved="$(stty -g)"
    stty raw -echo || {
        echo "Error: terminal settings locked, keys cannot reach Arch OS" >&2
        exit 1
    }
    stty "$saved"
fi

# A test harness passes the trace target as the credential arch-os.trace.
trace=()
if [ -s "${CREDENTIALS_DIRECTORY:-/nonexistent}/arch-os.trace" ]; then
    trace=(--trace "$(cat "${CREDENTIALS_DIRECTORY}/arch-os.trace")")
fi

cd /opt/arch-os
exec ./arch-os "$@" "${trace[@]}"
